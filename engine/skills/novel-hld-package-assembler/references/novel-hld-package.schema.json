{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"novel-hld-package.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","skill","stage","hld_run_id","status","stage_references","canonical_models","semantic_review","authority_partition","baseline_controls","open_items","hld_decisions","unresolved_dependency_summary","package_profile"],
  "properties":{
    "schema_version":{"const":"1.0"},"skill":{"const":"novel-hld-package-assembler"},"stage":{"const":"HP1"},"hld_run_id":{"type":"string","minLength":1},"status":{"const":"ready"},
    "stage_references":{"type":"array","minItems":9,"maxItems":9,"items":{"$ref":"#/$defs/stageRef"}},
    "canonical_models":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/modelRef"}},
    "semantic_review":{"$ref":"#/$defs/plainRef"},
    "authority_partition":{"$ref":"common.schema.json#/$defs/authorityPartition"},
    "baseline_controls":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/baselineControl"}},
    "open_items":{"type":"array","items":{"$ref":"#/$defs/openItem"}},
    "hld_decisions":{"type":"array","minItems":7,"maxItems":7,"items":{"$ref":"#/$defs/decisionRef"}},
    "unresolved_dependency_summary":{"type":"array","items":{"$ref":"#/$defs/summary"}},
    "package_profile":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "stageRef":{"type":"object","additionalProperties":false,"required":["stage","completion_sha256","manifest_sha256","validation_sha256"],"properties":{"stage":{"enum":["HB0","HA1","HS1","HC1","HI1","HR1","HK1","HD1","HQ1"]},"completion_sha256":{"$ref":"#/$defs/sha"},"manifest_sha256":{"$ref":"#/$defs/sha"},"validation_sha256":{"$ref":"#/$defs/sha"}}},
    "modelRef":{"type":"object","additionalProperties":false,"required":["stage","path","sha256"],"properties":{"stage":{"enum":["HA1","HS1","HC1","HI1","HR1","HK1","HD1"]},"path":{"type":"string","pattern":"^canonical-models/.+\\.json$"},"sha256":{"$ref":"#/$defs/sha"}}},
    "plainRef":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string","minLength":1},"sha256":{"$ref":"#/$defs/sha"}}},
    "openItem":{"type":"object","additionalProperties":false,"required":["origin_stage","value_json","value_sha256"],"properties":{"origin_stage":{"enum":["HB0","HA1","HS1","HC1","HI1","HR1","HK1","HD1"]},"value_json":{"type":"string","minLength":2},"value_sha256":{"$ref":"#/$defs/sha"}}},
    "baselineControl":{"type":"object","additionalProperties":false,"required":["source_id","domain","classification","open_item","authority_class","source_value_sha256"],"properties":{"source_id":{"type":"string","minLength":1},"domain":{"type":"string","minLength":1},"classification":{"enum":["mandatory","freedom","must_ask","open"]},"open_item":{"type":"boolean"},"authority_class":{"enum":["author_locked","autonomous_owned","downstream_freedom","author_open"]},"source_value_sha256":{"$ref":"#/$defs/sha"}}},
    "decisionRef":{"type":"object","additionalProperties":false,"required":["stage","model_path","locator","value_sha256","count"],"properties":{"stage":{"enum":["HA1","HS1","HC1","HI1","HR1","HK1","HD1"]},"model_path":{"type":"string","minLength":1},"locator":{"const":"/design_decisions"},"value_sha256":{"$ref":"#/$defs/sha"},"count":{"type":"integer","minimum":0}}},
    "hddRef":{"type":"object","additionalProperties":false,"required":["id","owner_stage","value_sha256"],"properties":{"id":{"type":"string","pattern":"^HDD-.+"},"owner_stage":{"enum":["HA1","HS1","HC1","HI1","HR1","HK1","HD1","HQ1"]},"value_sha256":{"$ref":"#/$defs/sha"}}},
    "summary":{"type":"object","additionalProperties":false,"required":["source_id","stage_hdd_refs","aggregate_disposition","resolution_ref"],"properties":{"source_id":{"type":"string","minLength":1},"stage_hdd_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/hddRef"}},"aggregate_disposition":{"enum":["not_needed_for_current_hld","conditionally_preserved","resolved"]},"resolution_ref":{"type":["string","null"]}}}
  }
}
