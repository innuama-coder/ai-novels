{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"hld-cross-index.schema.json","type":"object","additionalProperties":false,
  "required":["schema_version","skill","stage","hld_run_id","status","entries"],
  "properties":{"schema_version":{"const":"1.0"},"skill":{"const":"novel-hld-package-assembler"},"stage":{"const":"HP1"},"hld_run_id":{"type":"string","minLength":1},"status":{"const":"ready"},"entries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/entry"}}},
  "$defs":{"entry":{"type":"object","additionalProperties":false,"required":["id","owner_stage","model_path","locator","value_sha256","kind"],"properties":{"id":{"type":"string","minLength":1},"owner_stage":{"enum":["HB0","HA1","HS1","HC1","HI1","HR1","HK1","HD1"]},"model_path":{"type":"string","pattern":"^(?:canonical-models/.+\\.json|novel-hld-package\\.json)$"},"locator":{"type":"string","pattern":"^/"},"value_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"kind":{"enum":["source_control","canonical_object"]}}}}
}
