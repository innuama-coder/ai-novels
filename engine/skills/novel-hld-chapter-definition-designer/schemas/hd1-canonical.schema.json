{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"hd1-canonical.schema.json",
  "$defs":{
    "strings":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "nonEmptyStrings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "institutionalChoiceActor":{"type":"object","additionalProperties":false,"required":["actor_role","source_refs","responsibility","authority_limit"],"properties":{"actor_role":{"type":"string","minLength":2},"source_refs":{"$ref":"#/$defs/sourceRefs"},"responsibility":{"type":"string","minLength":8},"authority_limit":{"type":"string","minLength":8}}},
    "sourceRefs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/sourceId"}},
    "authorityRef":{"type":"object","additionalProperties":false,"required":["source_id","classification","open_item","authority_class","value_sha256"],"properties":{"source_id":{"$ref":"common.schema.json#/$defs/sourceId"},"classification":{"enum":["mandatory","freedom","must_ask","open"]},"open_item":{"type":"boolean"},"authority_class":{"enum":["author_locked","autonomous_owned","downstream_freedom","author_open"]},"value_sha256":{"$ref":"common.schema.json#/$defs/sha256"}}},
    "authorityRefs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/authorityRef"}},
    "ownership":{"enum":["source_projection","hld_owned","preserved_open","lld_freedom"]},
    "resolution":{"oneOf":[{"type":"null"},{"$ref":"common.schema.json#/$defs/fileReference"}]},
    "hdd":{"type":"object","additionalProperties":false,"required":["id","source_id","owner_stage","affected_obligation_ids","disposition","object_evidence_refs","rationale_anchor","downstream_effect","resolution_ref"],"properties":{"id":{"type":"string","pattern":"^HDD-HD1-"},"source_id":{"$ref":"common.schema.json#/$defs/sourceId"},"owner_stage":{"const":"HD1"},"affected_obligation_ids":{"$ref":"#/$defs/strings"},"disposition":{"enum":["not_needed_for_current_stage","conditional_structure_preserves_open","required_now","resolved_by_external_author_event"]},"object_evidence_refs":{"$ref":"#/$defs/strings"},"rationale_anchor":{"type":"string","minLength":1},"downstream_effect":{"type":"string","minLength":1},"resolution_ref":{"$ref":"#/$defs/resolution"}}},
    "stateBlock":{"type":"object","additionalProperties":false,"required":["story_state","character_state","knowledge_state","pressure_state","available_actions"],"properties":{"story_state":{"type":"string","minLength":8},"character_state":{"type":"string","minLength":8},"knowledge_state":{"type":"string","minLength":8},"pressure_state":{"type":"string","minLength":8},"available_actions":{"$ref":"#/$defs/nonEmptyStrings"}}},
    "storylineRoles":{"type":"object","additionalProperties":false,"required":["primary_storyline_id","supporting_storyline_ids","background_storyline_ids","preserved_open_storyline_ids"],"properties":{"primary_storyline_id":{"type":"string","minLength":1},"supporting_storyline_ids":{"$ref":"#/$defs/strings"},"background_storyline_ids":{"$ref":"#/$defs/strings"},"preserved_open_storyline_ids":{"$ref":"#/$defs/strings"}}},
    "pov":{"type":"object","additionalProperties":false,"required":["hi1_assignment_id","focal_character_id","pov_mode","may_know","must_not_know","reader_knows_before","reader_knows_after"],"properties":{"hi1_assignment_id":{"type":"string","pattern":"^HPV-"},"focal_character_id":{"type":"string","minLength":1},"pov_mode":{"type":"string","minLength":1},"may_know":{"$ref":"#/$defs/nonEmptyStrings"},"must_not_know":{"$ref":"#/$defs/nonEmptyStrings"},"reader_knows_before":{"$ref":"#/$defs/nonEmptyStrings"},"reader_knows_after":{"$ref":"#/$defs/nonEmptyStrings"}}},
    "dramatic":{"type":"object","additionalProperties":false,"required":["choice_actor_ids","institutional_choice_actors","cost_bearer_ids","immediate_goal","active_opposition","pressure_escalation","consequential_choice","choice_cost","immediate_consequence","irreversible_change"],"properties":{"choice_actor_ids":{"$ref":"#/$defs/strings"},"institutional_choice_actors":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/institutionalChoiceActor"}},"cost_bearer_ids":{"$ref":"#/$defs/nonEmptyStrings"},"immediate_goal":{"type":"string","minLength":8},"active_opposition":{"type":"string","minLength":8},"pressure_escalation":{"type":"string","minLength":8},"consequential_choice":{"type":"string","minLength":8},"choice_cost":{"type":"string","minLength":8},"immediate_consequence":{"type":"string","minLength":8},"irreversible_change":{"type":"string","minLength":8}}},
    "development":{"type":"object","additionalProperties":false,"required":["required_developments","information_revealed","information_withheld","fair_clues","relationship_changes"],"properties":{"required_developments":{"$ref":"#/$defs/nonEmptyStrings"},"information_revealed":{"$ref":"#/$defs/nonEmptyStrings"},"information_withheld":{"$ref":"#/$defs/nonEmptyStrings"},"fair_clues":{"$ref":"#/$defs/nonEmptyStrings"},"relationship_changes":{"$ref":"#/$defs/nonEmptyStrings"}}},
    "memory":{"type":"object","additionalProperties":false,"required":["trigger","fragment_scope","historical_position","presentation_position","initial_interpretation","contradiction_or_counterevidence","present_consequence","later_verification_or_reinterpretation","truth_status","objective_evidence_rule"],"properties":{"trigger":{"type":"string","minLength":8},"fragment_scope":{"type":"string","minLength":8},"historical_position":{"type":"string","minLength":8},"presentation_position":{"type":"string","minLength":8},"initial_interpretation":{"type":"string","minLength":8},"contradiction_or_counterevidence":{"type":"string","minLength":8},"present_consequence":{"type":"string","minLength":8},"later_verification_or_reinterpretation":{"type":"string","minLength":8},"truth_status":{"enum":["confirmed_partial","distorted","misattributed","unresolved"]},"objective_evidence_rule":{"const":"memory_alone_is_not_objective_evidence"}}},
    "references":{"type":"object","additionalProperties":false,"required":["character_ids","environment_ids","event_ids","key_function_ids"],"properties":{"character_ids":{"$ref":"#/$defs/nonEmptyStrings"},"environment_ids":{"$ref":"#/$defs/nonEmptyStrings"},"event_ids":{"$ref":"#/$defs/strings"},"key_function_ids":{"$ref":"#/$defs/nonEmptyStrings"}}},
    "lld":{"type":"object","additionalProperties":false,"required":["scene_design_must_solve","freedoms","prohibitions","acceptance_criteria"],"properties":{"scene_design_must_solve":{"$ref":"#/$defs/nonEmptyStrings"},"freedoms":{"$ref":"#/$defs/nonEmptyStrings"},"prohibitions":{"$ref":"#/$defs/nonEmptyStrings"},"acceptance_criteria":{"$ref":"#/$defs/nonEmptyStrings"}}},
    "chapter":{"type":"object","additionalProperties":false,"required":["id","source_refs","source_authority_refs","ownership_class","resolution_ref","chapter_id","chapter_number","working_title","parent_unit_id","narrative_necessity","entry_state","time_scope","place_scope","storyline_roles","pov_contract","dramatic_contract","story_development","memory_design","exit_state","chapter_end_hook","unresolved_question","next_chapter_necessity","references","lld_handoff"],"properties":{"id":{"type":"string","pattern":"^HDF-[A-Za-z0-9._-]+$"},"source_refs":{"$ref":"#/$defs/sourceRefs"},"source_authority_refs":{"$ref":"#/$defs/authorityRefs"},"ownership_class":{"$ref":"#/$defs/ownership"},"resolution_ref":{"$ref":"#/$defs/resolution"},"chapter_id":{"type":"string","pattern":"^HCH-"},"chapter_number":{"type":"integer","minimum":1},"working_title":{"type":"string","minLength":1},"parent_unit_id":{"type":"string","minLength":1},"narrative_necessity":{"type":"string","minLength":12},"entry_state":{"$ref":"#/$defs/stateBlock"},"time_scope":{"type":"string","minLength":4},"place_scope":{"$ref":"#/$defs/nonEmptyStrings"},"storyline_roles":{"$ref":"#/$defs/storylineRoles"},"pov_contract":{"$ref":"#/$defs/pov"},"dramatic_contract":{"$ref":"#/$defs/dramatic"},"story_development":{"$ref":"#/$defs/development"},"memory_design":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/memory"}]},"exit_state":{"$ref":"#/$defs/stateBlock"},"chapter_end_hook":{"type":"string","minLength":8},"unresolved_question":{"type":"string","minLength":8},"next_chapter_necessity":{"type":"string","minLength":8},"references":{"$ref":"#/$defs/references"},"lld_handoff":{"$ref":"#/$defs/lld"}}},
    "chain":{"type":"object","additionalProperties":false,"required":["id","source_refs","source_authority_refs","ownership_class","resolution_ref","from_chapter_id","to_chapter_id","inherited_change","unresolved_pressure","continuity_requirement","why_next_cannot_be_skipped"],"properties":{"id":{"type":"string","pattern":"^HDC-[A-Za-z0-9._-]+$"},"source_refs":{"$ref":"#/$defs/sourceRefs"},"source_authority_refs":{"$ref":"#/$defs/authorityRefs"},"ownership_class":{"$ref":"#/$defs/ownership"},"resolution_ref":{"$ref":"#/$defs/resolution"},"from_chapter_id":{"type":"string","pattern":"^HCH-"},"to_chapter_id":{"type":"string","pattern":"^HCH-"},"inherited_change":{"type":"string","minLength":8},"unresolved_pressure":{"type":"string","minLength":8},"continuity_requirement":{"type":"string","minLength":8},"why_next_cannot_be_skipped":{"type":"string","minLength":8}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","skill","stage","hld_run_id","status","input_gate_ref","source_artifacts","authority_partition","design_decisions","derivation_claims","decision_dependencies","open_items","downstream_contract","chapter_definitions","chapter_chain","coverage_summary"],
  "properties":{
    "schema_version":{"const":"1.0"},"skill":{"const":"novel-hld-chapter-definition-designer"},"stage":{"const":"HD1"},"hld_run_id":{"type":"string","minLength":1},"status":{"const":"ready"},"input_gate_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "source_artifacts":{"type":"array","minItems":1,"items":{"$ref":"common.schema.json#/$defs/fileReference"}},"authority_partition":{"$ref":"common.schema.json#/$defs/authorityPartition"},
    "design_decisions":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","choice","candidate_refs"],"properties":{"id":{"type":"string","pattern":"^HDDES-HD1-"},"choice":{"type":"string","minLength":1},"candidate_refs":{"$ref":"#/$defs/nonEmptyStrings"}}}},
    "derivation_claims":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["id","source_refs","target_locator","value_sha256"],"properties":{"id":{"$ref":"common.schema.json#/$defs/stableId"},"source_refs":{"$ref":"#/$defs/sourceRefs"},"target_locator":{"type":"string","pattern":"^/"},"value_sha256":{"$ref":"common.schema.json#/$defs/sha256"}}}},
    "decision_dependencies":{"type":"array","items":{"$ref":"#/$defs/hdd"}},"open_items":{"type":"array","uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/sourceId"}},
    "downstream_contract":{"type":"object","additionalProperties":false,"required":["consumer","required_roles"],"properties":{"consumer":{"const":"HQ1"},"required_roles":{"$ref":"#/$defs/nonEmptyStrings"}}},
    "chapter_definitions":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/chapter"}},"chapter_chain":{"type":"array","items":{"$ref":"#/$defs/chain"}},
    "coverage_summary":{"type":"object","additionalProperties":false,"required":["chapter_shell_ids","chapter_definition_ids","storyline_ids","character_ids","environment_ids","event_ids","key_function_ids"],"properties":{"chapter_shell_ids":{"$ref":"#/$defs/nonEmptyStrings"},"chapter_definition_ids":{"$ref":"#/$defs/nonEmptyStrings"},"storyline_ids":{"$ref":"#/$defs/nonEmptyStrings"},"character_ids":{"$ref":"#/$defs/nonEmptyStrings"},"environment_ids":{"$ref":"#/$defs/nonEmptyStrings"},"event_ids":{"$ref":"#/$defs/strings"},"key_function_ids":{"$ref":"#/$defs/nonEmptyStrings"}}}
  }
}
