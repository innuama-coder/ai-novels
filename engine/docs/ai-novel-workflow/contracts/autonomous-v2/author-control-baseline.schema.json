{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-control-baseline.schema.json",
  "title": "Autonomous conception V2 author control baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "stage",
    "run_id",
    "source_run_id",
    "status",
    "source_kind",
    "run_state",
    "design_artifacts",
    "v1_completion",
    "v2_completion",
    "v2_author_approval",
    "fact_dependency_register",
    "control_registry",
    "fact_dependencies",
    "open_items"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "stage": {"const": "B0"},
    "run_id": {"type": "string", "minLength": 1},
    "source_run_id": {"type": "string", "minLength": 1},
    "status": {"const": "ready"},
    "source_kind": {
      "enum": ["native", "compatibility_migration", "authority_revision"]
    },
    "run_state": {
      "description": "Current source-state authority. For authority_revision this must equal finalization.parent_run and the bootstrap revision-000 source_interview_state; a migrated base state remains only in parent B0 ancestry.",
      "$ref": "common-defs.schema.json#/$defs/artifactReference"
    },
    "design_artifacts": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "completion", "artifact", "control_ids"],
        "properties": {
          "domain": {"enum": ["I0", "I1", "I2", "I3", "I4", "I5"]},
          "completion": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
          "artifact": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
          "source_artifact": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
          "control_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "common-defs.schema.json#/$defs/sourceId"},
            "uniqueItems": true
          }
        }
      }
    },
    "v1_completion": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "v2_completion": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "v2_author_approval": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "migration_finalization": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "authority_revision_finalization": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "base_source_kind": {"enum": ["native", "compatibility_migration"]},
    "base_migration_finalization": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "parent_b0_baseline": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "parent_b0_completion": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "parent_b0_manifest": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "base_design_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common-defs.schema.json#/$defs/artifactReference"}
    },
    "effective_design_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "common-defs.schema.json#/$defs/artifactReference"}
    },
    "fact_dependency_register": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "control_registry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "hardness", "artifact", "heading", "value_sha256"],
        "properties": {
          "id": {"$ref": "common-defs.schema.json#/$defs/sourceId"},
          "domain": {"enum": ["I0", "I1", "I2", "I3", "I4", "I5"]},
          "hardness": {
            "enum": ["author_locked", "autonomous_owned", "downstream_freedom", "author_open"]
          },
          "artifact": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
          "heading": {"type": "string", "minLength": 1},
          "value_sha256": {"$ref": "common-defs.schema.json#/$defs/sha256"}
        }
      }
    },
    "fact_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/factDependency"}
    },
    "open_items": {
      "type": "array",
      "items": {"$ref": "common-defs.schema.json#/$defs/sourceId"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"source_kind": {"enum": ["native", "compatibility_migration"]}}, "required": ["source_kind"]},
      "then": {"not": {"anyOf": [{"required": ["base_source_kind"]}, {"required": ["base_migration_finalization"]}, {"required": ["parent_b0_baseline"]}, {"required": ["parent_b0_completion"]}, {"required": ["parent_b0_manifest"]}]}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "native"}}, "required": ["source_kind"]},
      "then": {"not": {"anyOf": [{"required": ["migration_finalization"]}, {"required": ["authority_revision_finalization"]}]}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "compatibility_migration"}}, "required": ["source_kind"]},
      "then": {"required": ["migration_finalization"], "not": {"required": ["authority_revision_finalization"]}}
    },
    {
      "if": {"properties": {"source_kind": {"const": "authority_revision"}}, "required": ["source_kind"]},
      "then": {
        "description": "Runtime validation also requires run_state to equal authority_revision_finalization.parent_run and the authority bootstrap source_interview_state.",
        "required": ["authority_revision_finalization", "base_source_kind", "base_design_artifacts", "effective_design_artifacts"],
        "not": {"required": ["migration_finalization"]}
      }
    },
    {
      "if": {"properties": {"source_kind": {"const": "authority_revision"}, "base_source_kind": {"const": "compatibility_migration"}}, "required": ["source_kind", "base_source_kind"]},
      "then": {"required": ["base_migration_finalization", "parent_b0_baseline", "parent_b0_completion", "parent_b0_manifest"]}
    },
    {
      "if": {"properties": {"source_kind": {"const": "authority_revision"}, "base_source_kind": {"const": "native"}}, "required": ["source_kind", "base_source_kind"]},
      "then": {"not": {"anyOf": [{"required": ["base_migration_finalization"]}, {"required": ["parent_b0_baseline"]}, {"required": ["parent_b0_completion"]}, {"required": ["parent_b0_manifest"]}]}}
    },
    {"properties": {"design_artifacts": {"contains": {"properties": {"domain": {"const": "I0"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"design_artifacts": {"contains": {"properties": {"domain": {"const": "I1"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"design_artifacts": {"contains": {"properties": {"domain": {"const": "I2"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"design_artifacts": {"contains": {"properties": {"domain": {"const": "I3"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"design_artifacts": {"contains": {"properties": {"domain": {"const": "I4"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"design_artifacts": {"contains": {"properties": {"domain": {"const": "I5"}}, "required": ["domain"]}, "minContains": 1, "maxContains": 1}}},
    {"properties": {"control_registry": {"contains": {"properties": {"domain": {"const": "I0"}}, "required": ["domain"]}}}},
    {"properties": {"control_registry": {"contains": {"properties": {"domain": {"const": "I1"}}, "required": ["domain"]}}}},
    {"properties": {"control_registry": {"contains": {"properties": {"domain": {"const": "I2"}}, "required": ["domain"]}}}},
    {"properties": {"control_registry": {"contains": {"properties": {"domain": {"const": "I3"}}, "required": ["domain"]}}}},
    {"properties": {"control_registry": {"contains": {"properties": {"domain": {"const": "I4"}}, "required": ["domain"]}}}},
    {"properties": {"control_registry": {"contains": {"properties": {"domain": {"const": "I5"}}, "required": ["domain"]}}}}
  ],
  "$defs": {
    "factDependency": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "claim", "rationale"],
          "properties": {
            "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
            "status": {"const": "not_applicable"},
            "claim": {"type": "string", "minLength": 1},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id", "status", "claim", "research_package", "adoption_record",
            "allowed_use", "fiction_boundary"
          ],
          "properties": {
            "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
            "status": {"const": "adopted"},
            "claim": {"type": "string", "minLength": 1},
            "research_package": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
            "adoption_record": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
            "allowed_use": {"type": "string", "minLength": 1},
            "fiction_boundary": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "status", "claim", "blocking", "allowed_handling", "rationale"],
          "properties": {
            "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
            "status": {"const": "open"},
            "claim": {"type": "string", "minLength": 1},
            "blocking": {"const": false},
            "allowed_handling": {"const": "preserve_open"},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      ]
    }
  }
}
