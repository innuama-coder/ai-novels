{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event-timeline.schema.json",
  "title": "T1 event timeline canonical model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "stage", "run_id", "status", "input_gate", "source_artifacts", "authority_partition", "design_decisions", "derivation_claims", "event_demands", "event_span", "timeline_axes", "proposition_registry", "major_events", "causal_edges", "storyline_event_sequences", "connection_realization", "obligation_realizations", "environment_placement", "state_ledger", "information_changes", "event_coverage_ledger", "narrative_timing_constraints", "open_items"],
  "properties": {
    "schema_version": {"enum": ["2.0", "2.1", "2.2", "2.3", "2.4", "2.5"]}, "skill": {"const": "novel-event-timeline-designer"}, "stage": {"const": "T1"}, "run_id": {"type": "string", "minLength": 1}, "status": {"const": "ready"}, "input_gate": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "source_artifacts": {"$ref": "canonical-common.schema.json#/$defs/sourceArtifacts"}, "authority_partition": {"$ref": "canonical-common.schema.json#/$defs/authorityPartition"}, "design_decisions": {"$ref": "canonical-common.schema.json#/$defs/designDecisions"}, "derivation_claims": {"$ref": "canonical-common.schema.json#/$defs/derivationClaims"},
    "event_demands": {"$ref": "canonical-common.schema.json#/$defs/eventRequirements"},
    "e1_universe_digest_bundle": {"$ref": "#/$defs/e1Digest"},
    "e1_capability_graph_digest": {"$ref": "#/$defs/e1Digest"},
    "e1_occurrence_requirement_digest": {"$ref": "#/$defs/e1Digest"},
    "event_span": {"$ref": "#/$defs/eventSpan"},
    "timeline_axes": {"$ref": "#/$defs/timelineAxes"},
    "initial_condition_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/initialCondition"}},
    "initial_anchor_option_selection_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/initialOptionSelection"}},
    "planned_event_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plannedEvent"}},
    "process_state_subject_registry": {"type": "array", "items": {"$ref": "#/$defs/processSubject"}},
    "planned_proposition_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/plannedProposition"}},
    "planned_causal_edges": {"type": "array", "items": {"$ref": "#/$defs/causalEdge"}},
    "transition_event_cover": {"type": "array", "minItems": 1},
    "milestone_event_buckets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milestoneBucket"}},
    "connection_event_paths": {"type": "array", "items": {"$ref": "#/$defs/connectionEventPath"}},
    "obligation_event_plan": {"type": "array", "items": {"$ref": "#/$defs/obligationEventPlan"}},
    "capability_occurrence_event_cover": {"type": "array", "items": {"$ref": "#/$defs/occurrenceCover"}},
    "authority_token_instance_ledger": {"type": "array", "items": {"$ref": "#/$defs/tokenInstance"}},
    "lifecycle_scope": {"$ref": "#/$defs/lifecycleScope"},
    "lifecycle_contract_registry": {"type": "array", "items": {"$ref": "#/$defs/lifecycleContract"}},
    "proposition_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/proposition"}},
    "major_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}},
    "causal_edges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/causalEdge"}},
    "storyline_event_sequences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/storylineSequence"}},
    "connection_realization": {"type": "array", "items": {"$ref": "#/$defs/connectionRealization"}},
    "obligation_realizations": {"type": "array", "items": {"$ref": "#/$defs/obligationRealization"}},
    "environment_placement": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/environmentPlacement"}},
    "state_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-common.schema.json#/$defs/stateTransition"}},
    "information_changes": {"type": "array"},
    "event_coverage_ledger": {"$ref": "canonical-common.schema.json#/$defs/coverageRecords"},
    "narrative_timing_constraints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timingConstraint"}},
    "open_items": {"$ref": "canonical-common.schema.json#/$defs/openItems"}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"enum": ["2.0", "2.1"]}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "causal_edges": {"items": {"$ref": "#/$defs/causalEdgeLegacy"}},
          "planned_causal_edges": {"items": {"$ref": "#/$defs/causalEdgeLegacy"}},
          "information_changes": {"items": {"$ref": "canonical-common.schema.json#/$defs/informationChange"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.2"}}, "required": ["schema_version"]},
      "then": {
        "required": ["e1_universe_digest_bundle", "e1_capability_graph_digest", "e1_occurrence_requirement_digest", "initial_condition_registry", "initial_anchor_option_selection_ledger", "planned_event_registry", "process_state_subject_registry", "planned_proposition_registry", "planned_causal_edges", "transition_event_cover", "milestone_event_buckets", "connection_event_paths", "obligation_event_plan", "capability_occurrence_event_cover", "authority_token_instance_ledger"],
        "properties": {
          "major_events": {"items": {"$ref": "#/$defs/event22"}},
          "proposition_registry": {"items": {"$ref": "#/$defs/proposition22"}},
          "transition_event_cover": {"items": {"$ref": "#/$defs/transitionCover22"}},
          "causal_edges": {"items": {"$ref": "#/$defs/causalEdgeLegacy"}},
          "planned_causal_edges": {"items": {"$ref": "#/$defs/causalEdgeLegacy"}},
          "information_changes": {"items": {"$ref": "canonical-common.schema.json#/$defs/informationChange"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.3"}}, "required": ["schema_version"]},
      "then": {
        "required": ["e1_universe_digest_bundle", "e1_capability_graph_digest", "e1_occurrence_requirement_digest", "initial_condition_registry", "initial_anchor_option_selection_ledger", "planned_event_registry", "process_state_subject_registry", "planned_proposition_registry", "planned_causal_edges", "transition_event_cover", "milestone_event_buckets", "connection_event_paths", "obligation_event_plan", "capability_occurrence_event_cover", "authority_token_instance_ledger"],
        "properties": {
          "major_events": {"items": {"$ref": "#/$defs/event22"}},
          "proposition_registry": {"items": {"$ref": "#/$defs/proposition22"}},
          "transition_event_cover": {"items": {"$ref": "#/$defs/transitionCover23"}},
          "causal_edges": {"items": {"$ref": "#/$defs/causalEdgeLegacy"}},
          "planned_causal_edges": {"items": {"$ref": "#/$defs/causalEdgeLegacy"}},
          "information_changes": {"items": {"$ref": "canonical-common.schema.json#/$defs/informationChange"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.4"}}, "required": ["schema_version"]},
      "then": {
        "required": ["e1_universe_digest_bundle", "e1_capability_graph_digest", "e1_occurrence_requirement_digest", "initial_condition_registry", "initial_anchor_option_selection_ledger", "planned_event_registry", "process_state_subject_registry", "planned_proposition_registry", "planned_causal_edges", "transition_event_cover", "milestone_event_buckets", "connection_event_paths", "obligation_event_plan", "capability_occurrence_event_cover", "authority_token_instance_ledger"],
        "properties": {
          "major_events": {"items": {"$ref": "#/$defs/event22"}},
          "proposition_registry": {"items": {"$ref": "#/$defs/proposition22"}},
          "transition_event_cover": {"items": {"$ref": "#/$defs/transitionCover23"}},
          "causal_edges": {"items": {"$ref": "#/$defs/causalEdge24"}},
          "planned_causal_edges": {"items": {"$ref": "#/$defs/causalEdge24"}},
          "information_changes": {"items": {"$ref": "#/$defs/informationChange24"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.5"}}, "required": ["schema_version"]},
      "then": {
        "required": ["e1_universe_digest_bundle", "e1_capability_graph_digest", "e1_occurrence_requirement_digest", "initial_condition_registry", "initial_anchor_option_selection_ledger", "planned_event_registry", "process_state_subject_registry", "planned_proposition_registry", "planned_causal_edges", "transition_event_cover", "milestone_event_buckets", "connection_event_paths", "obligation_event_plan", "capability_occurrence_event_cover", "authority_token_instance_ledger", "lifecycle_scope", "lifecycle_contract_registry"],
        "properties": {
          "major_events": {"items": {"$ref": "#/$defs/event25"}},
          "planned_event_registry": {"items": {"$ref": "#/$defs/plannedEvent25"}},
          "proposition_registry": {"items": {"$ref": "#/$defs/proposition22"}},
          "transition_event_cover": {"items": {"$ref": "#/$defs/transitionCover23"}},
          "causal_edges": {"items": {"$ref": "#/$defs/causalEdge24"}},
          "planned_causal_edges": {"items": {"$ref": "#/$defs/causalEdge24"}},
          "information_changes": {"items": {"$ref": "#/$defs/informationChange24"}}
        }
      }
    }
  ],
  "$defs": {
    "eventSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "granularity", "calendar_rules"],
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "granularity": {"type": "string", "minLength": 1},
        "calendar_rules": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"}
      }
    },
    "timelineAxes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_time_basis", "narrative_time_strategy", "axes"],
      "properties": {
        "world_time_basis": {"type": "string", "minLength": 1},
        "narrative_time_strategy": {"type": "string", "minLength": 1},
        "axes": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"}
      }
    },
    "proposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_ids", "audience", "initially_true", "terminality"],
      "properties": {
        "id": {"type": "string", "pattern": "^PROP-[A-Za-z0-9._-]+$"},
        "statement": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "audience": {"type": ["string", "null"], "enum": ["reader", "characters", "both", null]},
        "initially_true": {"type": "boolean"},
        "terminality": {"enum": ["ordinary", "unique_terminal"]},
        "initial_anchor_refs": {"type": "array", "items": {"$ref": "#/$defs/initialAnchorRef"}, "uniqueItems": true},
        "producer_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"}, "uniqueItems": true}
      }
    },
    "proposition22": {
      "allOf": [
        {"$ref": "#/$defs/proposition"},
        {"required": ["initial_anchor_refs", "producer_event_ids"]}
      ]
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "responsibility", "world_time", "storyline_ids", "environment_id", "participant_slot_ids", "initiator_slot_id", "counter_slot_ids", "preconditions", "initiating_action", "complication", "decisive_change", "direct_result", "before_state", "after_state", "next_pressure", "requires_proposition_ids", "produces_proposition_ids", "discloses_proposition_ids", "information_changes", "predecessor_event_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "responsibility": {"type": "string", "minLength": 1},
        "world_time": {"type": "string", "minLength": 1},
        "storyline_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "participant_slot_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SLOT-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "initiator_slot_id": {"type": "string", "pattern": "^SLOT-[A-Za-z0-9._-]+$"},
        "counter_slot_ids": {"type": "array", "items": {"type": "string", "pattern": "^SLOT-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "preconditions": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "initiating_action": {"type": "string", "minLength": 1},
        "complication": {"type": "string", "minLength": 1},
        "decisive_change": {"type": "string", "minLength": 1},
        "direct_result": {"type": "string", "minLength": 1},
        "before_state": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "after_state": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
        "next_pressure": {"type": "string", "minLength": 1},
        "requires_proposition_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "produces_proposition_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "discloses_proposition_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "information_changes": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "predecessor_event_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "event_kind": {"enum": ["story_transition", "connection_bridge", "process", "authority_transition"]},
        "milestone_id": {"type": "string", "minLength": 1},
        "subject_id": {"type": "string", "minLength": 1},
        "subject_kind": {"type": "string", "minLength": 1},
        "affordance_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "e1_capability_step_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "capability_step_occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stepOccurrence"}},
        "requires_capability_fact_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "produces_capability_fact_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "requires_token_instance_ids": {"type": "array", "items": {"type": "string", "pattern": "^ATI-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "consumes_token_instance_ids": {"type": "array", "items": {"type": "string", "pattern": "^ATI-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "produces_token_instance_ids": {"type": "array", "items": {"type": "string", "pattern": "^ATI-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "lifecycle_effects": {"type": "array", "items": {"$ref": "#/$defs/lifecycleEffect"}},
        "initial_anchor_refs": {"type": "array", "items": {"$ref": "#/$defs/initialAnchorComponentRef"}, "uniqueItems": true},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "atomicity_reason": {"type": "string", "minLength": 1}
      }
    },
    "event22": {
      "allOf": [
        {"$ref": "#/$defs/event"},
        {
          "required": ["event_kind", "milestone_id", "subject_id", "subject_kind", "affordance_ids", "e1_capability_step_ids", "capability_step_occurrences", "requires_capability_fact_ids", "produces_capability_fact_ids", "requires_token_instance_ids", "produces_token_instance_ids", "initial_anchor_refs", "source_ids", "atomicity_reason"],
          "properties": {
            "before_state": {"minProperties": 1, "maxProperties": 1},
            "after_state": {"minProperties": 1, "maxProperties": 1}
          }
        }
      ]
    },
    "event25": {
      "allOf": [
        {"$ref": "#/$defs/event22"},
        {"required": ["consumes_token_instance_ids", "lifecycle_effects"]}
      ]
    },
    "informationChange24": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subject_id", "proposition_id", "before", "after", "event_ids", "source_occurrence_id", "source_obligation_ids", "visibility_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^INFO-[A-Za-z0-9._-]+$"},
        "subject_id": {"type": "string", "pattern": "^SLOT-[A-Za-z0-9._-]+$"},
        "proposition_id": {"type": "string", "pattern": "^PROP-[A-Za-z0-9._-]+$"},
        "before": {"type": "string", "minLength": 1},
        "after": {"type": "string", "minLength": 1},
        "event_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "source_occurrence_id": {"type": "string", "pattern": "^CSO-[A-Za-z0-9._-]+$"},
        "source_obligation_ids": {"type": "array", "items": {"type": "string", "pattern": "^SOB-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "visibility_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SLOT-[A-Za-z0-9._-]+$"}, "uniqueItems": true}
      }
    },
    "causalEdge": {
      "oneOf": [
        {"$ref": "#/$defs/causalEdgeLegacy"},
        {"$ref": "#/$defs/causalEdge24"}
      ]
    },
    "causalEdgeLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_event_id", "to_event_id", "mechanism", "necessary_condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^CE-[A-Za-z0-9._-]+$"},
        "from_event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "to_event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "mechanism": {"type": "string", "minLength": 1},
        "necessary_condition": {"type": "string", "minLength": 1}
      }
    },
    "causalEdge24": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_event_id", "to_event_id", "edge_kind", "payload_ids", "mechanism", "necessary_condition"],
      "properties": {
        "id": {"type": "string", "pattern": "^CE-[A-Za-z0-9._-]+$"},
        "from_event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "to_event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "edge_kind": {"enum": ["narrative_causal", "capability_dependency", "proposition_dependency", "token_dependency", "sequencing"]},
        "payload_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "mechanism": {"type": "string", "minLength": 1},
        "necessary_condition": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"edge_kind": {"enum": ["capability_dependency", "proposition_dependency", "token_dependency"]}}},
          "then": {"properties": {"payload_ids": {"minItems": 1}}},
          "else": {"properties": {"payload_ids": {"maxItems": 0}}}
        }
      ]
    },
    "storylineSequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "storyline_id", "event_ids", "entry_state", "exit_state", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^SEQ-[A-Za-z0-9._-]+$"},
        "storyline_id": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"},
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "entry_state": {"type": "string", "minLength": 1},
        "exit_state": {"type": "string", "minLength": 1},
        "status": {"const": "complete"}
      }
    },
    "stateAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "storyline_id", "state_index", "state", "side"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "storyline_id": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"},
        "state_index": {"type": "integer", "minimum": 0},
        "state": {"type": "string", "minLength": 1},
        "side": {"enum": ["before", "after"]}
      }
    },
    "connectionRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "connection_id", "relation", "realization_kind", "source_anchor", "target_anchor", "causal_edge_ids", "timing_constraint_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^CR-[A-Za-z0-9._-]+$"},
        "connection_id": {"type": "string", "pattern": "^SLC-[A-Za-z0-9._-]+$"},
        "relation": {"enum": ["causal", "associative"]},
        "realization_kind": {"enum": ["causal_handoff", "associative_alignment"]},
        "source_anchor": {"$ref": "#/$defs/stateAnchor"},
        "target_anchor": {"$ref": "#/$defs/stateAnchor"},
        "causal_edge_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^CE-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "timing_constraint_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^TIME-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {"properties": {"relation": {"const": "causal"}}},
          "then": {
            "properties": {
              "realization_kind": {"const": "causal_handoff"},
              "causal_edge_ids": {"minItems": 1}
            }
          },
          "else": {
            "properties": {
              "realization_kind": {"const": "associative_alignment"},
              "causal_edge_ids": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "obligationRealization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "obligation_id", "kind", "antecedent_proposition_ids", "consequent_proposition_id", "event_ids", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^OBR-[A-Za-z0-9._-]+$"},
        "obligation_id": {"type": "string", "pattern": "^SOB-[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["causes", "strict_before", "not_before", "requires_all", "first_disclosure", "must_remain_unknown"]},
        "antecedent_proposition_ids": {"type": "array", "items": {"type": "string", "pattern": "^PROP-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "consequent_proposition_id": {"type": "string", "pattern": "^PROP-[A-Za-z0-9._-]+$"},
        "event_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "evidence": {"type": "string", "minLength": 1}
      }
    },
    "environmentPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "environment_id", "affordance_ids", "fit_evidence"],
      "properties": {
        "event_id": {"type": "string", "pattern": "^EV-[A-Za-z0-9._-]+$"},
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "affordance_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
