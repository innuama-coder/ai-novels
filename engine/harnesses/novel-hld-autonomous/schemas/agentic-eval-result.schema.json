{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic-eval-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harness", "harness_version", "qualification_run_id", "case_id", "layer", "target_stage", "target_skill", "fixture_ref", "fixture_manifest_ref", "prompt_ref", "instruction_refs", "producer_task_id", "reviewer_task_id", "producer_task_receipt_ref", "reviewer_task_receipt_ref", "producer_transcript_ref", "reviewer_transcript_ref", "fresh_context", "prior_conclusions_exposed", "expected_answer_exposed", "allowed_read_refs", "actual_read_refs", "produced_artifact_refs", "deterministic_validation_refs", "semantic_review_ref", "dimensions", "blockers", "verdict", "completed_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "harness": {"const": "novel-hld-autonomous"},
    "harness_version": {"$ref": "common.schema.json#/$defs/semver"},
    "qualification_run_id": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "pattern": "^[A-Z0-9-]+$"},
    "layer": {"enum": ["bounded_skill", "harness"]},
    "target_stage": {"type": "string", "minLength": 2},
    "target_skill": {"type": ["string", "null"]},
    "fixture_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "fixture_manifest_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "prompt_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "instruction_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}, "uniqueItems": true},
    "producer_task_id": {"type": "string", "minLength": 1},
    "reviewer_task_id": {"type": "string", "minLength": 1},
    "producer_task_receipt_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "reviewer_task_receipt_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "producer_transcript_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "reviewer_transcript_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "fresh_context": {"const": true},
    "prior_conclusions_exposed": {"const": false},
    "expected_answer_exposed": {"const": false},
    "allowed_read_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}, "uniqueItems": true},
    "actual_read_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}, "uniqueItems": true},
    "produced_artifact_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}, "uniqueItems": true},
    "deterministic_validation_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}, "uniqueItems": true},
    "semantic_review_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "dimensions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dimension", "score", "evidence_refs"],
        "properties": {
          "dimension": {"type": "string", "minLength": 1},
          "score": {"type": "integer", "minimum": 0, "maximum": 2},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}, "uniqueItems": true}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "verdict": {"enum": ["pass", "revise", "fail"]},
    "completed_at": {"type": "string", "format": "date-time"}
  }
}
