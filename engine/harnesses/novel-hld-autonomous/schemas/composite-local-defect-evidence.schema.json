{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"composite-local-defect-evidence.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","skill","stage","hld_run_id","code","evidence","affected_ids"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "skill":{"type":"string","minLength":1},
    "stage":{"const":"HH1"},
    "hld_run_id":{"type":"string","minLength":1},
    "code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
    "evidence":{"type":"string","minLength":1},
    "affected_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
