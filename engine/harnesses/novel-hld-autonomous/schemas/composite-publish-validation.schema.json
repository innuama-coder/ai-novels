{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"composite-publish-validation.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","harness","stage","hld_run_id","revision","status","checks","errors"],
  "properties":{
    "schema_version":{"const":"1.0"},"harness":{"const":"novel-hld-autonomous"},"stage":{"enum":["HQ2","HH1"]},
    "hld_run_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":0},
    "status":{"enum":["pass","revise","blocked","runtime_error"]},
    "checks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "errors":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}
  }
}
