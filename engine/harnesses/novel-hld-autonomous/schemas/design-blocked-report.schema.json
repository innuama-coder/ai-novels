{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"design-blocked-report.schema.json","type":"object","additionalProperties":false,"required":["schema_version","skill","stage","hld_run_id","status","blocker_class","code","evidence","required_action"],"properties":{"schema_version":{"const":"1.0"},"skill":{"type":"string","minLength":1},"stage":{"enum":["HA1","HS1","HC1","HI1","HR1","HK1","HD1"]},"hld_run_id":{"type":"string","minLength":1},"status":{"const":"blocked"},"blocker_class":{"enum":["author_required","upstream_defect"]},"code":{"enum":["AUTHOR_REQUIRED","UPSTREAM_DEFECT"]},"evidence":{"type":"string","minLength":1},"required_action":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"blocker_class":{"const":"author_required"}}},"then":{"properties":{"code":{"const":"AUTHOR_REQUIRED"}}}},{"if":{"properties":{"blocker_class":{"const":"upstream_defect"}}},"then":{"properties":{"code":{"const":"UPSTREAM_DEFECT"}}}}]}
