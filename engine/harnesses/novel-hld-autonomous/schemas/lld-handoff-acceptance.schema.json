    "hld_run_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":0},"status":{"const":"ready"},
    "consumer_test_ref":{"$ref":"common.schema.json#/$defs/fileReference"},"consumer_manifest_ref":{"$ref":"common.schema.json#/$defs/fileReference"},"consumer_result_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "fidelity_test_ref":{"$ref":"common.schema.json#/$defs/fileReference"},"fidelity_manifest_ref":{"$ref":"common.schema.json#/$defs/fileReference"},"fidelity_result_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "hp1_completion_ref":{"$ref":"common.schema.json#/$defs/fileReference"},"hb0_completion_ref":{"$ref":"common.schema.json#/$defs/fileReference"}
  }
}
