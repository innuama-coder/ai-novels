{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"lld-handoff-acceptance.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","harness","stage","hld_run_id","revision","status","consumer_test_ref","consumer_manifest_ref","consumer_result_ref","fidelity_test_ref","fidelity_manifest_ref","fidelity_result_ref","hp1_completion_ref","hb0_completion_ref"],
  "properties":{
