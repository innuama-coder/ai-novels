{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hb0-execution.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "stage", "hld_run_id", "work_order_id", "implementation_sha256", "input_hashes", "preparation_validator_exit_code", "read_roles", "output_hashes", "deterministic"],
  "properties": {
    "schema_version": {"const": "1.0"}, "skill": {"const": "novel-hld-baseline-admitter"}, "stage": {"const": "HB0"},
    "hld_run_id": {"type": "string", "minLength": 1}, "work_order_id": {"type": "string", "minLength": 1},
    "implementation_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "input_hashes": {"type": "object", "additionalProperties": {"$ref": "common.schema.json#/$defs/sha256"}},
    "preparation_validator_exit_code": {"const": 0},
    "read_roles": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "output_hashes": {"type": "object", "additionalProperties": {"$ref": "common.schema.json#/$defs/sha256"}},
    "deterministic": {"const": true}
  }
}
