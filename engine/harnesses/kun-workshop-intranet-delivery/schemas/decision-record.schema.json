{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision and Escalation Record",
  "type": "object",
  "required": ["id", "run_id", "decision_type", "owner", "evidence", "options", "outcome", "status"],
  "properties": {
    "id": {"type": "string"}, "run_id": {"type": "string"},
    "decision_type": {"enum": ["priority", "architecture", "scope", "risk_acceptance", "return_route", "deployment_authorisation"]},
    "owner": {"type": "string"}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "options": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "outcome": {"type": "string"},
    "status": {"enum": ["proposed", "approved", "rejected", "blocked"]}, "human_approval_reference": {"type": "string"}
  },
  "allOf": [{"if": {"properties": {"decision_type": {"enum": ["scope", "risk_acceptance", "deployment_authorisation"]}}}, "then": {"required": ["human_approval_reference"]}}],
  "additionalProperties": false
}
