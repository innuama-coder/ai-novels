{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/novel-conception-interview/independent-handoff.schema.json",
  "title": "R1 role-separated development-map handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "harness",
    "run_id",
    "stage",
    "verdict",
    "reviewer_id",
    "reviewer_role",
    "assurance",
    "evidence_scope",
    "method",
    "d1_package",
    "subject_ids",
    "world_model_reviews",
    "storyline_reviews",
    "character_demand_reviews",
    "character_profile_reviews",
    "relationship_edge_reviews",
    "relationship_network_reviews",
    "development_gap_reviews",
    "design_decision_reviews",
    "derivation_reviews",
    "tasks"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "harness": {"const": "novel-conception-interview"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"const": "R1"},
    "verdict": {"const": "pass"},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewer_role": {"const": "independent_developer"},
    "assurance": {"const": "role_separated_execution"},
    "evidence_scope": {"const": "d1_package_only"},
    "method": {"type": "string", "minLength": 20},
    "d1_package": {"$ref": "#/$defs/reference"},
    "subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "world_model_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "storyline_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "character_demand_reviews": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "demand_id",
          "category",
          "status",
          "finding",
          "resolution",
          "profile_id",
          "decision_ids"
        ],
        "properties": {
          "demand_id": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "decision_authority",
              "information_transfer",
              "expertise_formation",
              "opposition_execution",
              "relationship_pressure",
              "operational_execution",
              "aftermath_responsibility"
            ]
          },
          "status": {"const": "pass"},
          "finding": {"type": "string", "minLength": 60},
          "resolution": {"enum": ["profile", "not_applicable"]},
          "profile_id": {
            "type": ["string", "null"],
            "minLength": 1
          },
          "decision_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "character_profile_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "relationship_edge_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "relationship_network_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "development_gap_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "design_decision_reviews": {
      "type": "array",
      "items": {"type": "object"}
    },
    "derivation_reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "derivation_id",
          "status",
          "finding",
          "source_control_ids",
          "source_decision_ids"
        ],
        "properties": {
          "derivation_id": {"type": "string", "minLength": 1},
          "status": {"const": "pass"},
          "finding": {"type": "string", "minLength": 20},
          "source_control_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "source_decision_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "response", "evidence_ids"],
        "properties": {
          "id": {
            "enum": [
              "promise",
              "autonomous_value",
              "causal_chain",
              "unit_contract",
              "freedom_boundary",
              "drift_detection",
              "easy_solution",
              "scene_plan"
            ]
          },
          "status": {"const": "pass"},
          "response": {"type": "string", "minLength": 40},
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
