{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Novel conception interview plan",
  "type": "object",
  "required": ["harness", "run_id", "stage", "session_id", "revision", "question_budget", "groups", "planned_minutes", "transcript_assurance"],
  "properties": {
    "harness": {"const": "novel-conception-interview"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["I0", "I1", "I2", "I3", "I4", "I5"]},
    "session_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "supersedes": {"type": "string"},
    "question_budget": {"type": "integer", "minimum": 1},
    "planned_minutes": {"type": "integer", "minimum": 1},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "budget"], "properties": {"id": {"type": "string"}, "budget": {"type": "integer", "minimum": 0}}}},
    "transcript_assurance": {"const": "self_recorded"},
    "output_artifact": {"type": "string"}
  }
}
