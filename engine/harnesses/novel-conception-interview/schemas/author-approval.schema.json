{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Author approval for a reviewed novel-conception brief",
  "type": "object",
  "required": ["harness", "run_id", "approval_scope", "decision", "record_assurance", "review_brief", "approval_record"],
  "properties": {
    "harness": {"const": "novel-conception-interview"},
    "run_id": {"type": "string", "minLength": 1},
    "approval_scope": {"enum": ["V2", "R1"]},
    "decision": {"enum": ["approved", "revise", "rejected"]},
    "record_assurance": {"const": "self_recorded"},
    "review_brief": {"type": "object", "required": ["path", "sha256"]},
    "approval_record": {"type": "object", "required": ["event_seq", "text"]},
    "unresolved_items": {"type": "array"}
  }
}
