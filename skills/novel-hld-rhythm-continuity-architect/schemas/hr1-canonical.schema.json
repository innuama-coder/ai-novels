{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hr1-canonical.schema.json",
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/sourceId"
      }
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "classification",
        "open_item",
        "authority_class",
        "value_sha256"
      ],
      "properties": {
        "source_id": {
          "$ref": "common.schema.json#/$defs/sourceId"
        },
        "classification": {
          "enum": [
            "mandatory",
            "freedom",
            "must_ask",
            "open"
          ]
        },
        "open_item": {
          "type": "boolean"
        },
        "authority_class": {
          "enum": [
            "author_locked",
            "autonomous_owned",
            "downstream_freedom",
            "author_open"
          ]
        },
        "value_sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "authorityRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authorityRef"
      }
    },
    "ownership": {
      "enum": [
        "source_projection",
        "hld_owned",
        "preserved_open",
        "lld_freedom"
      ]
    },
    "resolution": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "common.schema.json#/$defs/fileReference"
        }
      ]
    },
    "hdd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "owner_stage",
        "affected_obligation_ids",
        "disposition",
        "object_evidence_refs",
        "rationale_anchor",
        "downstream_effect",
        "resolution_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HDD-HR1-"
        },
        "source_id": {
          "$ref": "common.schema.json#/$defs/sourceId"
        },
        "owner_stage": {
          "const": "HR1"
        },
        "affected_obligation_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "disposition": {
          "enum": [
            "not_needed_for_current_stage",
            "conditional_structure_preserves_open",
            "required_now",
            "resolved_by_external_author_event"
          ]
        },
        "object_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "rationale_anchor": {
          "type": "string",
          "minLength": 1
        },
        "downstream_effect": {
          "type": "string",
          "minLength": 1
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        }
      }
    },
    "storyTime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "epoch",
        "ordering_rule",
        "precision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTM-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "epoch": {
          "type": "string",
          "minLength": 1
        },
        "ordering_rule": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "unit_id",
        "narrative_position",
        "story_time_anchor",
        "order_mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTM-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "narrative_position": {
          "type": "integer",
          "minimum": 0
        },
        "story_time_anchor": {
          "type": "string",
          "minLength": 1
        },
        "order_mode": {
          "enum": [
            "chronological",
            "analepsis",
            "prolepsis",
            "parallel",
            "mixed"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "duration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "unit_id",
        "story_duration_class",
        "discourse_density",
        "compression_permission"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTM-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "story_duration_class": {
          "enum": [
            "instant",
            "short",
            "medium",
            "long",
            "open"
          ]
        },
        "discourse_density": {
          "enum": [
            "compressed",
            "balanced",
            "expanded",
            "open"
          ]
        },
        "compression_permission": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "from_unit_id",
        "to_unit_id",
        "from_environment_id",
        "to_environment_id",
        "continuity_preconditions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTM-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "from_unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "to_unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "from_environment_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "to_environment_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "continuity_preconditions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "sync": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "branch_unit_ids",
        "synchronization_anchor"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTM-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "branch_unit_ids": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "synchronization_anchor": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "pace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "unit_id",
        "pace",
        "pressure_function"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HPC-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "pace": {
          "type": "string",
          "minLength": 1
        },
        "pressure_function": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "tension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "unit_id",
        "level",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTN-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "peak",
            "open"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "after_unit_ids",
        "function",
        "minimum_state_change"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HPC-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "after_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "minimum_state_change": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_refs",
        "source_authority_refs",
        "ownership_class",
        "resolution_ref",
        "unit_id",
        "entry_state_refs",
        "exit_state_refs",
        "knowledge_state_refs",
        "space_state_ref"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^HTM-[A-Za-z0-9._-]+$"
        },
        "source_refs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "source_authority_refs": {
          "$ref": "#/$defs/authorityRefs"
        },
        "ownership_class": {
          "$ref": "#/$defs/ownership"
        },
        "resolution_ref": {
          "$ref": "#/$defs/resolution"
        },
        "unit_id": {
          "$ref": "common.schema.json#/$defs/stableId"
        },
        "entry_state_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "exit_state_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "knowledge_state_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/stableId"
          }
        },
        "space_state_ref": {
          "$ref": "common.schema.json#/$defs/stableId"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ownership_class": {
                "enum": [
                  "hld_owned",
                  "preserved_open",
                  "lld_freedom"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "resolution_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "skill",
    "stage",
    "hld_run_id",
    "status",
    "input_gate_ref",
    "source_artifacts",
    "authority_partition",
    "design_decisions",
    "derivation_claims",
    "decision_dependencies",
    "open_items",
    "downstream_contract",
    "story_time_model",
    "narrative_order_map",
    "unit_duration_density",
    "space_transition_map",
    "parallel_synchronization",
    "pacing_curve",
    "tension_curve",
    "recovery_windows",
    "continuity_ledger"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "skill": {
      "const": "novel-hld-rhythm-continuity-architect"
    },
    "stage": {
      "const": "HR1"
    },
    "hld_run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "ready"
    },
    "input_gate_ref": {
      "$ref": "common.schema.json#/$defs/fileReference"
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/fileReference"
      }
    },
    "authority_partition": {
      "$ref": "common.schema.json#/$defs/authorityPartition"
    },
    "design_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "choice",
          "candidate_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^HDDES-HR1-"
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "candidate_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "derivation_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_refs",
          "target_locator",
          "value_sha256"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/stableId"
          },
          "source_refs": {
            "$ref": "#/$defs/sourceRefs"
          },
          "target_locator": {
            "type": "string",
            "pattern": "^/"
          },
          "value_sha256": {
            "$ref": "common.schema.json#/$defs/sha256"
          }
        }
      }
    },
    "decision_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hdd"
      }
    },
    "open_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/sourceId"
      }
    },
    "downstream_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "required_roles"
      ],
      "properties": {
        "consumer": {
          "const": "HK1"
        },
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "story_time_model": {
      "$ref": "#/$defs/storyTime"
    },
    "narrative_order_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/order"
      },
      "minItems": 1
    },
    "unit_duration_density": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/duration"
      },
      "minItems": 1
    },
    "space_transition_map": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/space"
      }
    },
    "parallel_synchronization": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sync"
      }
    },
    "pacing_curve": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pace"
      },
      "minItems": 1
    },
    "tension_curve": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tension"
      },
      "minItems": 1
    },
    "recovery_windows": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recovery"
      }
    },
    "continuity_ledger": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ledger"
      },
      "minItems": 1
    }
  }
}
