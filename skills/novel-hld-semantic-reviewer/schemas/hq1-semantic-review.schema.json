{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"hq1-semantic-review.schema.json",
  "$defs":{
    "evidence":{"type":"object","additionalProperties":false,"required":["stage","object_id","object_locator","actual_value","contract_anchor"],"properties":{"stage":{"enum":["HB0","HA1","HS1","HC1","HI1","HR1","HK1"]},"object_id":{"type":"string","minLength":1},"object_locator":{"type":"string","pattern":"^/"},"actual_value":{},"contract_anchor":{"type":"string","minLength":1}}},
    "evidenceList":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}},
    "check":{"type":"object","additionalProperties":false,"required":["check_id","status","evidence","reason"],"properties":{"check_id":{"type":"string","minLength":1},"status":{"enum":["pass","fail","not_applicable"]},"evidence":{"$ref":"#/$defs/evidenceList"},"reason":{"type":"string","minLength":1}}},
    "challenge":{"type":"object","additionalProperties":false,"required":["check_id","dimension","status","evidence","reason"],"properties":{"check_id":{"type":"string","pattern":"^HQC-"},"dimension":{"enum":["causality","resource_authority","knowledge_pov","time_space","character_state","choice_cost_consequence","theme_support","hld_lld_boundary"]},"status":{"enum":["pass","fail","not_applicable"]},"evidence":{"$ref":"#/$defs/evidenceList"},"reason":{"type":"string","minLength":1}}},
    "hdd":{"type":"object","additionalProperties":false,"required":["id","owner_stage","source_id","domain","affected_obligation_ids","disposition","object_evidence_refs","rationale_anchor","downstream_effect","resolution_ref"],"properties":{"id":{"type":"string","pattern":"^HDD-HQ1-"},"owner_stage":{"const":"HQ1"},"source_id":{"$ref":"common.schema.json#/$defs/sourceId"},"domain":{"const":"quality"},"affected_obligation_ids":{"type":"array","uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/stableId"}},"disposition":{"enum":["not_needed_for_current_stage","conditional_structure_preserves_open","required_now","resolved_by_external_author_event"]},"object_evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/stableId"}},"rationale_anchor":{"type":"string","minLength":1},"downstream_effect":{"type":"string","minLength":1},"resolution_ref":{"oneOf":[{"type":"null"},{"$ref":"common.schema.json#/$defs/fileReference"}]}}},
    "dependencyCheck":{"type":"object","additionalProperties":false,"required":["source_id","hdd_ref","status","evidence"],"properties":{"source_id":{"$ref":"common.schema.json#/$defs/sourceId"},"hdd_ref":{"type":"string","pattern":"^HDD-HQ1-"},"status":{"enum":["covered","conflict","requires_author"]},"evidence":{"$ref":"#/$defs/evidenceList"}}},
    "finding":{"type":"object","additionalProperties":false,"required":["id","severity","issue","evidence_refs","affected_ids","violated_contract","defect_origin","correction_condition"],"properties":{"id":{"type":"string","pattern":"^HFN-"},"severity":{"enum":["blocker","major","minor"]},"issue":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"affected_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"violated_contract":{"type":"string","minLength":1},"defect_origin":{"enum":["reviewer_local","upstream_content","author_required","reality_dependency"]},"correction_condition":{"type":"string","minLength":1}}},
    "passClaim":{"type":"object","additionalProperties":false,"required":["check_id","evidence","pass_anchor"],"properties":{"check_id":{"type":"string","minLength":1},"evidence":{"$ref":"#/$defs/evidenceList"},"pass_anchor":{"type":"string","minLength":1}}},
    "notApplicable":{"type":"object","additionalProperties":false,"required":["check_id","object_ids","reason"],"properties":{"check_id":{"type":"string","minLength":1},"object_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"reason":{"type":"string","minLength":1}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","skill","stage","hld_run_id","review_task_id","input_gate_ref","source_artifacts","domain_reviews","cross_domain_checks","authority_and_open_item_review","decision_dependencies","decision_dependency_review","causal_and_reality_challenges","boundary_review","findings","verdict","pass_claims","coverage_summary"],
  "properties":{
    "schema_version":{"const":"1.0"},"skill":{"const":"novel-hld-semantic-reviewer"},"stage":{"const":"HQ1"},"hld_run_id":{"type":"string","minLength":1},"review_task_id":{"type":"string","minLength":1},"input_gate_ref":{"$ref":"common.schema.json#/$defs/fileReference"},"source_artifacts":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/fileReference"}},
    "domain_reviews":{"type":"array","minItems":6,"maxItems":6,"items":{"$ref":"#/$defs/check"}},"cross_domain_checks":{"type":"array","minItems":4,"items":{"$ref":"#/$defs/check"}},"authority_and_open_item_review":{"$ref":"#/$defs/check"},"decision_dependencies":{"type":"array","items":{"$ref":"#/$defs/hdd"}},"decision_dependency_review":{"type":"array","items":{"$ref":"#/$defs/dependencyCheck"}},"causal_and_reality_challenges":{"type":"array","minItems":8,"maxItems":8,"items":{"$ref":"#/$defs/challenge"}},"boundary_review":{"$ref":"#/$defs/check"},"findings":{"type":"array","items":{"$ref":"#/$defs/finding"}},"verdict":{"enum":["pass","revise","fail"]},"pass_claims":{"type":"array","items":{"$ref":"#/$defs/passClaim"}},
    "coverage_summary":{"type":"object","additionalProperties":false,"required":["checked_object_ids","applicable_checks","not_applicable_checks"],"properties":{"checked_object_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"applicable_checks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"not_applicable_checks":{"type":"array","items":{"$ref":"#/$defs/notApplicable"}}}}
  }
}
