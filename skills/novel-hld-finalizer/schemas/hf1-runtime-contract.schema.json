{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"hf1-runtime-contract.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["contract_schema_version","skill","stage","owner_version","upstream_stages","result_scope","task_kinds","public_entrypoint","implementation_closure","required_roles","completion_profile","next_stage"],
  "properties":{
    "contract_schema_version":{"const":"1.0"},
    "skill":{"const":"novel-hld-finalizer"},
    "stage":{"const":"HF1"},
    "owner_version":{"const":"1.0.0"},
    "upstream_stages":{"type":"array","minItems":12,"maxItems":12,"uniqueItems":true,"items":{"enum":["HB0","HA1","HS1","HC1","HI1","HR1","HK1","HD1","HQ1","HP1","HQ2","HH1"]}},
    "result_scope":{"const":"top_level"},
    "task_kinds":{"type":"array","minItems":1,"maxItems":1,"items":{"const":"HF1"}},
    "public_entrypoint":{"type":"object","additionalProperties":false,"required":["path","runtime","arguments"],"properties":{"path":{"const":"skills/novel-hld-finalizer/scripts/validate_package.py"},"runtime":{"const":"python"},"arguments":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"enum":["mode","work_order","input_gate","workspace"]}}}},
    "implementation_closure":{"type":"object","additionalProperties":false,"required":["algorithm","ordered_files"],"properties":{"algorithm":{"const":"sha256-relative-path-nul-content-nul-v1"},"ordered_files":{"type":"array","minItems":7,"maxItems":7,"uniqueItems":true,"items":{"type":"string","pattern":"^skills/novel-hld-finalizer/"}}}},
    "required_roles":{"type":"array","minItems":10,"maxItems":10,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "completion_profile":{"type":"array","minItems":4,"maxItems":4,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "next_stage":{"const":"novel-lld"}
  }
}
