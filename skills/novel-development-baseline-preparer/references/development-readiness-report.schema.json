{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "development-readiness-report.schema.json",
  "title": "Blocked development readiness report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "project_id", "baseline_version", "status", "failed_checks", "required_action"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "skill": {"const": "novel-development-baseline-preparer"},
    "project_id": {"type": "string", "minLength": 1},
    "baseline_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "blocked"},
    "run_id": {"type": "string", "minLength": 1},
    "failed_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "evidence", "owner"],
        "properties": {
          "code": {"type": "string", "pattern": "^BASE_[A-Z0-9_]+$"},
          "evidence": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_action": {"type": "string", "minLength": 1}
  }
}
