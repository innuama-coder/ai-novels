{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"presentation-fidelity-review.schema.json",
  "$defs":{
    "sha":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "strings":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "string_set":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
    "dimension":{"type":"object","additionalProperties":false,"required":["verdict","claims","challenges","report_element_ids","source_ids","locators"],"properties":{"verdict":{"enum":["pass","fail"]},"claims":{"$ref":"#/$defs/strings"},"challenges":{"$ref":"#/$defs/strings"},"report_element_ids":{"$ref":"#/$defs/string_set"},"source_ids":{"$ref":"#/$defs/string_set"},"locators":{"$ref":"#/$defs/string_set"}}},
    "counts":{"type":"object","additionalProperties":false,"required":["cjk_characters","latin_words","visual_count","estimated_read_minutes"],"properties":{"cjk_characters":{"type":"integer","minimum":0},"latin_words":{"type":"integer","minimum":0},"visual_count":{"type":"integer","minimum":0},"estimated_read_minutes":{"type":"number","minimum":0}}},
    "drift":{"type":"object","additionalProperties":false,"required":["drift_type","affected_report_element_ids","source_ids","hp1_locators","report_evidence","material_impact","requested_correction"],"properties":{"drift_type":{"enum":["omission","weakening","enhancement","misattribution","fact_conflict","relation_conflict","order_conflict","numeric_conflict","status_conflict","authority_conflict","open_item_conflict","visual_data_conflict","binding_failure"]},"affected_report_element_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^H(RE|VG)-[A-Za-z0-9._-]+$"}},"source_ids":{"$ref":"#/$defs/strings"},"hp1_locators":{"$ref":"#/$defs/strings"},"report_evidence":{"type":"string","minLength":1},"material_impact":{"type":"string","minLength":1},"requested_correction":{"type":"string","minLength":1}}},
    "retrieval":{"type":"object","additionalProperties":false,"required":["question_code","question","answer","report_element_ids","source_ids","locators","verdict"],"properties":{"question_code":{"enum":["architecture_progression","world_environment_definitions","character_definitions","environment_definitions","mandatory_storyline_connections","core_arc_choices","pov_knowledge_boundaries","continuity_constraints","key_functions_and_climax","chapter_definition_readiness","open_items_and_lld_boundary"]},"question":{"type":"string","minLength":1},"answer":{"type":"string","minLength":1},"report_element_ids":{"$ref":"#/$defs/strings"},"source_ids":{"$ref":"#/$defs/strings"},"locators":{"$ref":"#/$defs/strings"},"verdict":{"enum":["pass","fail"]}}},
    "overload":{"type":"object","additionalProperties":false,"required":["overload_type","affected_report_element_ids","evidence","decision_impact"],"properties":{"overload_type":{"enum":["buried_conclusion","duplication","visual_burden","jargon","fragmentation","retrieval_failure","budget_overrun","process_noise"]},"affected_report_element_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^H(RE|VG)-[A-Za-z0-9._-]+$"}},"evidence":{"type":"string","minLength":1},"decision_impact":{"type":"string","minLength":1}}}
  },
  "type":"object","additionalProperties":false,
  "required":["schema_version","skill","stage","hld_run_id","revision","review_bindings","fact_fidelity","structure_and_relation_fidelity","coverage_fidelity","authority_and_open_item_fidelity","visual_data_fidelity","material_drift_findings","reading_budget_validation","decision_retrieval_tests","cognitive_overload_findings","defect_origin","verdict"],
  "properties":{
    "schema_version":{"const":"1.0"},"skill":{"const":"novel-hld-presentation-fidelity-reviewer"},"stage":{"const":"HH1"},"hld_run_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":0},
    "review_bindings":{"type":"object","additionalProperties":false,"required":["hp1_package_sha256","report_sha256","report_manifest_sha256","assembler_task_id","reviewer_task_id"],"properties":{"hp1_package_sha256":{"$ref":"#/$defs/sha"},"report_sha256":{"$ref":"#/$defs/sha"},"report_manifest_sha256":{"$ref":"#/$defs/sha"},"assembler_task_id":{"type":"string","minLength":1},"reviewer_task_id":{"type":"string","minLength":1}}},
    "fact_fidelity":{"$ref":"#/$defs/dimension"},"structure_and_relation_fidelity":{"$ref":"#/$defs/dimension"},"coverage_fidelity":{"$ref":"#/$defs/dimension"},"authority_and_open_item_fidelity":{"$ref":"#/$defs/dimension"},"visual_data_fidelity":{"$ref":"#/$defs/dimension"},
    "material_drift_findings":{"type":"array","items":{"$ref":"#/$defs/drift"}},
    "reading_budget_validation":{"type":"object","additionalProperties":false,"required":["formula","declared","recomputed","verdict"],"properties":{"formula":{"const":"CJK/500 + Latin/250 + visuals*0.25"},"declared":{"$ref":"#/$defs/counts"},"recomputed":{"$ref":"#/$defs/counts"},"verdict":{"enum":["pass","fail"]}}},
    "decision_retrieval_tests":{"type":"array","minItems":11,"items":{"$ref":"#/$defs/retrieval"}},
    "cognitive_overload_findings":{"type":"array","items":{"$ref":"#/$defs/overload"}},
    "defect_origin":{"enum":["none","reviewer_local","upstream_content"]},"verdict":{"enum":["pass","revise","fail"]}
  }
}
