{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intranet Delivery Plan",
  "type": "object",
  "required": ["run_id", "source_baseline", "work_packages", "dependency_edges", "created_by"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "source_baseline": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactRef"}},
    "work_packages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/workPackage"}},
    "dependency_edges": {"type": "array", "items": {"type": "object", "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}, "additionalProperties": false}},
    "created_by": {"const": "dispatcher"}
  },
  "$defs": {
    "artifactRef": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}, "additionalProperties": false},
    "workPackage": {"type": "object", "required": ["id", "owner_role", "objective", "inputs", "outputs", "acceptance_criteria", "definition_of_done"], "properties": {"id": {"type": "string"}, "owner_role": {"type": "string"}, "objective": {"type": "string"}, "inputs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}, "outputs": {"type": "array", "items": {"type": "string"}}, "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "definition_of_done": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
