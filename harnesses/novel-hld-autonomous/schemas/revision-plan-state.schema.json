{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revision-plan-state.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_plan_ref", "previous_plan_state_ref", "active_group_id", "pending_group_ids", "resolved_group_ids", "superseded_group_ids", "retarget_bindings", "plan_status", "transition_event_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "revision_plan_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "previous_plan_state_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "active_group_id": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^HRG-"}]},
    "pending_group_ids": {"type": "array", "items": {"type": "string", "pattern": "^HRG-"}, "uniqueItems": true},
    "resolved_group_ids": {"type": "array", "items": {"type": "string", "pattern": "^HRG-"}, "uniqueItems": true},
    "superseded_group_ids": {"type": "array", "items": {"type": "string", "pattern": "^HRG-"}, "uniqueItems": true},
    "retarget_bindings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id", "original_target_hash", "author_resolution_ref", "new_target_id", "request_meaning_hash"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^HRG-"},
          "original_target_hash": {"$ref": "common.schema.json#/$defs/sha256"},
          "author_resolution_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
          "new_target_id": {"type": "string", "minLength": 1},
          "request_meaning_hash": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    },
    "plan_status": {"enum": ["active", "waiting_retarget", "resolved"]},
    "transition_event_ref": {"$ref": "common.schema.json#/$defs/fileReference"}
  }
}
