{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"agent-task-receipt.schema.json",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","harness","harness_version","qualification_run_id","case_id","task_id","task_role","runtime","context_id","fresh_context","status","transcript_ref","started_at","completed_at"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "harness":{"const":"novel-hld-autonomous"},
    "harness_version":{"$ref":"common.schema.json#/$defs/semver"},
    "qualification_run_id":{"type":"string","minLength":1},
    "case_id":{"type":"string","pattern":"^[A-Z0-9-]+$"},
    "task_id":{"type":"string","minLength":1},
    "task_role":{"enum":["producer","reviewer"]},
    "runtime":{"const":"codex"},
    "context_id":{"type":"string","minLength":1},
    "fresh_context":{"const":true},
    "status":{"const":"completed"},
    "transcript_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "started_at":{"type":"string","format":"date-time"},
    "completed_at":{"type":"string","format":"date-time"}
  }
}
