{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"composite-workspace-state.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","harness","hld_run_id","revision","stage","workspace_id","state_before_ref","ordered_task_kinds","issued_tasks","unissued_task_kinds","last_issued_event_sequence"],
  "properties":{
    "schema_version":{"const":"1.0"},"harness":{"const":"novel-hld-autonomous"},
    "hld_run_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":0},
    "stage":{"enum":["HQ2","HH1"]},"workspace_id":{"type":"string","minLength":1},
    "state_before_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "ordered_task_kinds":{"type":"array","minItems":2,"uniqueItems":true,"items":{"enum":["consumer_test","fidelity_test","HH1-A","HH1-B","HH1-C"]}},
    "issued_tasks":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/task"}},
    "unissued_task_kinds":{"type":"array","uniqueItems":true,"items":{"enum":["consumer_test","fidelity_test","HH1-A","HH1-B","HH1-C"]}},
    "last_issued_event_sequence":{"type":"integer","minimum":1}
  },
  "$defs":{"task":{"type":"object","additionalProperties":false,"required":["task_kind","sequence","work_order_ref","stage_result_ref","package_manifest_ref"],"properties":{
    "task_kind":{"enum":["consumer_test","fidelity_test","HH1-A","HH1-B","HH1-C"]},
    "sequence":{"type":"integer","minimum":1},
    "work_order_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "stage_result_ref":{"$ref":"common.schema.json#/$defs/fileReference"},
    "package_manifest_ref":{"$ref":"common.schema.json#/$defs/fileReference"}
  }}}
}
