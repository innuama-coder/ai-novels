{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hb0-validation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "stage", "hld_run_id", "status", "checks", "errors", "artifacts"],
  "properties": {
    "schema_version": {"const": "1.0"}, "skill": {"const": "novel-hld-baseline-admitter"}, "stage": {"const": "HB0"},
    "hld_run_id": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "blocked"]},
    "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "errors": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/fileReference"}}
  }
}
