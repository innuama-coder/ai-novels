{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"design-gate-data.schema.json","type":"object","additionalProperties":false,"required":["schema_version","hld_run_id","stage","failed_gate","evidence","affected_ids"],"properties":{"schema_version":{"const":"1.0"},"hld_run_id":{"type":"string","minLength":1},"stage":{"enum":["HA1","HS1","HC1","HI1","HR1","HK1","HD1"]},"failed_gate":{"enum":["AUTHOR_REQUIRED","UPSTREAM_DEFECT"]},"evidence":{"type":"string","minLength":1},"affected_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"common.schema.json#/$defs/stableId"}},"source_control_id":{"$ref":"common.schema.json#/$defs/sourceId"},"question_text":{"type":"string","minLength":1}},"allOf":[{"if":{"properties":{"failed_gate":{"const":"AUTHOR_REQUIRED"}},"required":["failed_gate"]},"then":{"required":["source_control_id","question_text"]}}]}
