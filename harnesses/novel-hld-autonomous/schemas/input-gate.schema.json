{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input-gate.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harness", "hld_run_id", "stage", "mode", "state_before_ref", "hb0_completion_ref", "upstream_completions", "baseline_manifest_ref", "baseline_validation_ref", "source_lineage_refs", "exact_owner_skill", "owner_version", "implementation_sha256", "return_binding", "unresolved_projection", "revision_plan_ref", "revision_plan_state_ref", "file_allowlist"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "harness": {"const": "novel-hld-autonomous"},
    "hld_run_id": {"type": "string", "minLength": 1},
    "stage": {"$ref": "common.schema.json#/$defs/stage"},
    "mode": {"enum": ["forward", "return_resolution"]},
    "state_before_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "hb0_completion_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/artifactReference"}]},
    "upstream_completions": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/artifactReference"}},
    "baseline_manifest_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "baseline_validation_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "source_lineage_refs": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/fileReference"}},
    "exact_owner_skill": {"type": "string", "minLength": 1},
    "owner_version": {"$ref": "common.schema.json#/$defs/semver"},
    "implementation_sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "return_binding": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "unresolved_projection": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sourceId"}, "uniqueItems": true},
    "revision_plan_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "revision_plan_state_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "file_allowlist": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/fileReference"}}
  },
  "allOf": [
    {"if": {"properties": {"mode": {"const": "forward"}}}, "then": {"properties": {"return_binding": {"type": "null"}}}},
    {"if": {"properties": {"stage": {"const": "HB0"}}}, "then": {"properties": {"hb0_completion_ref": {"type": "null"}, "upstream_completions": {"maxItems": 0}, "unresolved_projection": {"maxItems": 0}}}}
  ]
}
