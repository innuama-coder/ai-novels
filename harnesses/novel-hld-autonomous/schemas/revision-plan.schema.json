{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "revision-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision_plan_id", "hld_run_id", "source_result_ref", "source_event_ref", "target_groups", "invalidated_suffix", "author_reapproval_required", "root_cause_fingerprints"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "revision_plan_id": {"type": "string", "pattern": "^HRP-[A-Za-z0-9._-]+$"},
    "hld_run_id": {"type": "string", "minLength": 1},
    "source_result_ref": {"$ref": "common.schema.json#/$defs/fileReference"},
    "source_event_ref": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/fileReference"}]},
    "target_groups": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["group_id", "exact_owner", "target_stage", "resume_stage", "target_kind", "affected_ids", "requirements", "source_target_refs", "invalidated_suffix", "completion_condition", "root_cause_fingerprint"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^HRG-[A-Za-z0-9._-]+$"},
          "exact_owner": {"type": "string", "minLength": 1},
          "target_stage": {"$ref": "common.schema.json#/$defs/stage"},
          "resume_stage": {"$ref": "common.schema.json#/$defs/stage"},
          "target_kind": {"enum": ["hld_content", "report_content", "presentation_review", "render_expression"]},
          "affected_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "source_target_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "invalidated_suffix": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/stage"}},
          "completion_condition": {"type": "string", "minLength": 1},
          "root_cause_fingerprint": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]}
        }
      }
    },
    "invalidated_suffix": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/stage"}},
    "author_reapproval_required": {"const": true},
    "root_cause_fingerprints": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/sha256"}, "uniqueItems": true}
  }
}
