{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interview fact dependency register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "harness", "run_id", "stage", "status", "fact_dependencies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "harness": {"const": "novel-conception-interview"},
    "run_id": {"type": "string", "minLength": 1},
    "stage": {"const": "V1"},
    "status": {"const": "ready"},
    "fact_dependencies": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "status", "claim", "rationale"],
          "properties": {
            "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
            "status": {"const": "not_applicable"},
            "claim": {"type": "string", "minLength": 1},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "status", "claim", "research_package", "adoption_record", "allowed_use", "fiction_boundary"],
          "properties": {
            "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
            "status": {"const": "adopted"},
            "claim": {"type": "string", "minLength": 1},
            "research_package": {"$ref": "#/$defs/artifactReference"},
            "adoption_record": {"$ref": "#/$defs/artifactReference"},
            "allowed_use": {"type": "string", "minLength": 1},
            "fiction_boundary": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["id", "status", "claim", "blocking", "allowed_handling", "rationale"],
          "properties": {
            "id": {"type": "string", "pattern": "^FACT-[A-Za-z0-9._-]+$"},
            "status": {"const": "open"},
            "claim": {"type": "string", "minLength": 1},
            "blocking": {"const": false},
            "allowed_handling": {"const": "preserve_open"},
            "rationale": {"type": "string", "minLength": 1}
          }
        }
      ]}
    }
  },
  "$defs": {
    "artifactReference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
