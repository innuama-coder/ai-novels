{
  "node": "proposal",
  "version": "2026-07-05.v1",
  "proposal_skill_count": 12,
  "harness": "novel-proposal-workflow",
  "contract_rules": [
    {
      "id": "CONTRACT-01",
      "rule": "Every business gate must have an independent skill owner; the harness may only dispatch, package, reject, rerun, or reopen."
    },
    {
      "id": "CONTRACT-02",
      "rule": "A proposal cannot proceed past storyline gate unless the storyline quality report passes with concrete reference evidence."
    },
    {
      "id": "CONTRACT-03",
      "rule": "A proposal cannot proceed to expansion unless final reader promise and final core concept pass an independent consistency report."
    },
    {
      "id": "CONTRACT-04",
      "rule": "Integrator and risk checker must consume all hard gate reports; they cannot infer pass from missing reports."
    },
    {
      "id": "CONTRACT-05",
      "rule": "A sample proposal must include proof rows for every hard gate before it can be treated as workflow evidence."
    }
  ],
  "skills": [
    "novel-intake-boundary-ledger-builder",
    "novel-reader-promise-designer",
    "novel-core-concept-designer",
    "novel-storyline-designer",
    "novel-storyline-quality-evaluator",
    "novel-final-promise-concept-consistency-checker",
    "novel-macro-structure-designer",
    "novel-core-character-framer",
    "novel-world-premise-framer",
    "novel-ending-direction-designer",
    "novel-proposal-integrator",
    "novel-proposal-risk-checker"
  ],
  "hard_gates": [
    {
      "id": "GATE-INTAKE",
      "name": "intake boundary gate",
      "owner": "novel-intake-boundary-ledger-builder",
      "owner_type": "independent_skill",
      "input": ["intake brief"],
      "output": ["intake boundary ledger", "readiness verdict", "reopen_intake"],
      "blocking_rule": "Block if intake is not_ready or lacks a human motive seed plus at least one external pressure or suspense seed.",
      "sample_proof_required": "Readiness verdict"
    },
    {
      "id": "GATE-STORYLINE-QUALITY",
      "name": "storyline reference quality gate",
      "owner": "novel-storyline-quality-evaluator",
      "owner_type": "independent_skill",
      "input": ["complete story synopsis", "main story chain", "auxiliary storylines", "intake boundary ledger"],
      "output": ["storyline quality report", "reference evidence", "verdict"],
      "blocking_rule": "Block if verdict is not pass, if unresolved P0/P1 exists, or if reference evidence is missing.",
      "sample_proof_required": "Reference Evidence"
    },
    {
      "id": "GATE-FINAL-PROMISE-CONCEPT-CONSISTENCY",
      "name": "final promise concept consistency gate",
      "owner": "novel-final-promise-concept-consistency-checker",
      "owner_type": "independent_skill",
      "input": ["accepted storyline", "storyline quality report", "final reader promise", "final core concept"],
      "output": ["consistency report", "verdict"],
      "blocking_rule": "Block if final reader promise and final core concept are not mutually supportive or if either contradicts the accepted storyline.",
      "sample_proof_required": "Final Promise / Concept Consistency"
    },
    {
      "id": "GATE-INTEGRATION",
      "name": "proposal integration gate",
      "owner": "novel-proposal-integrator",
      "owner_type": "independent_skill",
      "input": [
        "all proposal skill outputs",
        "storyline quality report",
        "final promise/concept consistency report",
        "intake boundary ledger with readiness verdict",
        "accepted storyline",
        "all proposal expansion outputs"
      ],
      "output": ["proposal document", "integration verdict"],
      "blocking_rule": "Block if any source report is missing, evidence-free, contradictory, untraceable, or if critical final-proposal business claims lack Claim Source Map coverage.",
      "sample_proof_required": "Integration Verdict"
    },
    {
      "id": "GATE-FINAL-RISK",
      "name": "final proposal risk gate",
      "owner": "novel-proposal-risk-checker",
      "owner_type": "independent_skill",
      "input": [
        "proposal assembly artifact",
        "intake boundary ledger with readiness verdict",
        "accepted storyline",
        "storyline quality report",
        "final promise/concept consistency report",
        "integration verdict",
        "all proposal expansion outputs",
        "human/intake confirmation status"
      ],
      "output": ["agent quality verdict", "human/intake confirmation verdict", "PRD entry verdict"],
      "blocking_rule": "Block agent quality pass on unresolved P0/P1, missing reference evidence, missing consistency report, failed consistency verdict, or Integration Verdict without Claim Source Map coverage.",
      "sample_proof_required": "Agent quality verdict"
    }
  ],
