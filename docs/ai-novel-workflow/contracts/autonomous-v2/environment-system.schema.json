{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "environment-system.schema.json",
  "title": "E1 environment system canonical model",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill", "stage", "run_id", "status", "input_gate", "source_artifacts", "authority_partition", "design_decisions", "derivation_claims", "storyline_environment_requirements", "environment_demands", "environments", "functional_zones", "environment_topology", "access_and_authority", "resource_and_information_channels", "hazards_and_failure_modes", "storyline_hosting_ledger", "event_affordance_catalog", "transition_contracts", "open_items"],
  "properties": {
    "schema_version": {"enum": ["2.0", "2.1", "2.2", "2.3", "2.4"]}, "skill": {"const": "novel-environment-system-designer"}, "stage": {"const": "E1"}, "run_id": {"type": "string", "minLength": 1}, "status": {"const": "ready"}, "input_gate": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "source_artifacts": {"$ref": "canonical-common.schema.json#/$defs/sourceArtifacts"}, "authority_partition": {"$ref": "canonical-common.schema.json#/$defs/authorityPartition"}, "design_decisions": {"$ref": "canonical-common.schema.json#/$defs/designDecisions"}, "derivation_claims": {"$ref": "canonical-common.schema.json#/$defs/derivationClaims"},
    "storyline_environment_requirements": {"$ref": "canonical-common.schema.json#/$defs/environmentRequirements"},
    "environment_demands": {},
    "environments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/environment"}},
    "functional_zones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/zone"}},
    "environment_topology": {"type": "array"},
    "access_and_authority": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-common.schema.json#/$defs/assignment"}},
    "resource_and_information_channels": {"type": "array", "minItems": 1, "items": {"$ref": "canonical-common.schema.json#/$defs/relationEdge"}},
    "hazards_and_failure_modes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/failureMode"}},
    "storyline_hosting_ledger": {"type": "array", "minItems": 1},
    "event_affordance_catalog": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/affordance"}},
    "transition_contracts": {"type": "array", "minItems": 1},
    "open_items": {"$ref": "canonical-common.schema.json#/$defs/openItems"},
    "story_transition_universe_digest": {"$ref": "#/$defs/universeDigest"},
    "milestone_universe_digest": {"$ref": "#/$defs/universeDigest"},
    "connection_universe_digest": {"$ref": "#/$defs/universeDigest"},
    "obligation_universe_digest": {"$ref": "#/$defs/universeDigest"},
    "initial_anchor_support": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/initialAnchorSupport"}},
    "capability_fact_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capabilityFact"}},
    "capability_step_registry": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capabilityStep"}},
    "ambient_context_hosts": {"type": "array", "items": {"$ref": "#/$defs/ambientContextHost"}},
    "actor_authority_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actorAuthorityBinding"}},
    "capability_occurrence_requirements": {"type": "array", "items": {"$ref": "#/$defs/capabilityOccurrenceRequirement"}},
    "story_transition_support": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/storyTransitionSupport"}},
    "connection_path_readiness": {"type": "array", "items": {"$ref": "#/$defs/connectionReadiness"}},
    "milestone_capability_readiness": {"type": "array", "items": {"$ref": "#/$defs/milestoneReadiness"}},
    "obligation_capability_readiness": {"type": "array", "items": {"$ref": "#/$defs/obligationReadiness"}},
    "obligation_occurrence_bindings": {"type": "array", "items": {"$ref": "#/$defs/obligationOccurrenceBinding"}},
    "initial_anchor_option_realization_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/initialAnchorRealization"}}
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "storyline_hosting_ledger": {"$ref": "canonical-common.schema.json#/$defs/coverageRecords"},
          "environment_demands": {"$ref": "canonical-common.schema.json#/$defs/environmentRequirements"},
          "environment_topology": {"items": {"$ref": "canonical-common.schema.json#/$defs/relationEdge"}},
          "transition_contracts": {"items": {"$ref": "canonical-common.schema.json#/$defs/stateTransition"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.1"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "storyline_hosting_ledger": {"$ref": "canonical-common.schema.json#/$defs/coverageRecords"},
          "environment_demands": {"$ref": "canonical-common.schema.json#/$defs/environmentRequirements"},
          "environment_topology": {"items": {"$ref": "#/$defs/environmentTopologyEdge"}},
          "transition_contracts": {"items": {"$ref": "#/$defs/environmentStateTransition"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.2"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "storyline_hosting_ledger": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/hostingRecord"}
          },
          "environment_demands": {"$ref": "world-model.schema.json#/$defs/currentEnvironmentDemands"},
          "environment_topology": {"items": {"$ref": "#/$defs/environmentTopologyEdge"}},
          "transition_contracts": {"items": {"$ref": "#/$defs/environmentStateTransition"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.3"}}, "required": ["schema_version"]},
      "then": {
        "properties": {
          "storyline_hosting_ledger": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/hostingRecord"}
          },
          "environment_demands": {"$ref": "world-model.schema.json#/$defs/currentEnvironmentDemands"},
          "environment_topology": {"items": {"$ref": "#/$defs/environmentTopologyEdge"}},
          "transition_contracts": {"items": {"$ref": "#/$defs/environmentStateTransition"}}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "2.4"}}, "required": ["schema_version"]},
      "then": {
        "required": [
          "story_transition_universe_digest", "milestone_universe_digest",
          "connection_universe_digest", "obligation_universe_digest",
          "initial_anchor_support", "capability_fact_registry",
          "capability_step_registry", "ambient_context_hosts",
          "actor_authority_bindings", "capability_occurrence_requirements",
          "story_transition_support", "connection_path_readiness",
          "milestone_capability_readiness", "obligation_capability_readiness",
          "obligation_occurrence_bindings",
          "initial_anchor_option_realization_ledger"
        ],
        "properties": {
          "storyline_hosting_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hostingRecord"}},
          "environment_demands": {"$ref": "world-model.schema.json#/$defs/currentEnvironmentDemands"},
          "environment_topology": {"items": {"$ref": "#/$defs/environmentTopologyEdge"}},
          "transition_contracts": {"items": {"$ref": "#/$defs/environmentStateTransition"}}
        }
      }
    }
  ],
  "$defs": {
    "sourceMeaningBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_kind",
        "storyline_id",
        "responsibility_sha256",
        "constraint_sha256s"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^END-[A-Za-z0-9._-]+$"},
        "source_kind": {"enum": ["storyline_environment_requirement", "world_environment_demand"]},
        "storyline_id": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"},
        "responsibility_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "constraint_sha256s": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "uniqueItems": true
        }
      }
    },
    "localMeaningProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "token_kind",
        "token_sha256",
        "environment_pointer",
        "projection_sha256",
        "rationale"
      ],
      "properties": {
        "source_id": {"type": "string", "pattern": "^END-[A-Za-z0-9._-]+$"},
        "token_kind": {"enum": ["responsibility", "constraint"]},
        "token_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "environment_pointer": {
          "type": "string",
          "pattern": "^/(scope|narrative_responsibility|features/[0-9]+|sensory_conditions/[0-9]+|access_rules/[0-9]+|resources/[0-9]+|allowed_actions/[0-9]+|hazards/[0-9]+|blockers/[0-9]+|state_vocabulary/[0-9]+)$"
        },
        "projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "realizationMeaningBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "local_projections"],
      "properties": {
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "local_projections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/localMeaningProjection"}
        }
      }
    },
    "hostingEvidenceEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bindings", "realization_bindings"],
      "properties": {
        "source_bindings": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/sourceMeaningBinding"}
        },
        "realization_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/realizationMeaningBinding"}
        }
      }
    },
    "hostingRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_ids", "realization_ids", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^COV-[A-Za-z0-9._-]+$"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "realization_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "status": {"const": "covered"},
        "evidence": {"$ref": "#/$defs/hostingEvidenceEnvelope"}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "scope", "narrative_responsibility", "features", "sensory_conditions", "access_rules", "resources", "allowed_actions", "hazards", "zone_ids", "connections", "blockers", "state_vocabulary", "allowed_transitions", "storyline_stage_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "scope": {"type": "string", "minLength": 1},
        "narrative_responsibility": {"type": "string", "minLength": 1},
        "features": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "sensory_conditions": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "access_rules": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "resources": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "allowed_actions": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "hazards": {"$ref": "canonical-common.schema.json#/$defs/strings"},
        "zone_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^ZONE-[A-Za-z0-9._-]+$"}, "uniqueItems": true},
        "connections": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "blockers": {"$ref": "canonical-common.schema.json#/$defs/strings"},
        "state_vocabulary": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "allowed_transitions": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "storyline_stage_ids": {"type": "array", "minItems": 1, "items": {"$ref": "common-defs.schema.json#/$defs/objectId"}, "uniqueItems": true}
      }
    },
    "zone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "environment_id",
        "responsibility",
        "features",
        "access_rules",
        "resources",
        "constraints"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ZONE-[A-Za-z0-9._-]+$"},
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "responsibility": {"type": "string", "minLength": 1},
        "features": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "access_rules": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "resources": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"}
      }
    },
    "failureMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "environment_id", "trigger", "effect", "mitigation_limits"],
      "properties": {
        "id": {"type": "string", "pattern": "^HAZ-[A-Za-z0-9._-]+$"},
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "trigger": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1},
        "mitigation_limits": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"}
      }
    },
    "affordance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "environment_id",
        "event_requirement_ids",
        "allowed_actions",
        "prerequisites",
        "constraints"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^AFF-[A-Za-z0-9._-]+$"},
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "event_requirement_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "allowed_actions": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "prerequisites": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"}
      }
    },
    "environmentTopologyEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "from_id", "to_id", "relation", "mechanism", "constraints",
        "directionality", "transfer_capabilities"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^TOP-[A-Za-z0-9._-]+$"},
        "from_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "to_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "relation": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "directionality": {"enum": ["forward", "bidirectional"]},
        "transfer_capabilities": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}, "uniqueItems": true
        }
      }
    },
    "triggerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "source_environment_id",
        "source_storyline_id",
        "source_state_index",
        "target_storyline_id",
        "target_state_index",
        "causal_evidence_ids",
        "topology_path_ids",
        "transport_capability"
      ],
      "properties": {
        "trigger_id": {"type": "string", "pattern": "^AFF-[A-Za-z0-9._-]+$"},
        "source_environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "source_storyline_id": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"},
        "source_state_index": {"type": "integer", "minimum": 0},
        "target_storyline_id": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"},
        "target_state_index": {"type": "integer", "minimum": 0},
        "causal_evidence_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^(SLC|SOB)-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "topology_path_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^TOP-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        },
        "transport_capability": {"type": "string", "minLength": 1}
      }
    },
    "universeDigest": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "source_artifact", "source_pointer", "item_count", "canonical_items_sha256"],
      "properties": {
        "algorithm": {"const": "v2-canonical-json-sha256"},
        "source_artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["stage", "path", "sha256"],
          "properties": {
            "stage": {"const": "S1"},
            "path": {"type": "string", "pattern": "^sources/S1/.+$"},
            "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        "source_pointer": {"type": "string", "pattern": "^/.+$"},
        "item_count": {"type": "integer", "minimum": 0},
        "canonical_items_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "actionBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["environment_id", "affordance_id", "action"],
      "properties": {
        "environment_id": {"type": "string", "pattern": "^ENV-[A-Za-z0-9._-]+$"},
        "affordance_id": {"type": "string", "pattern": "^AFF-[A-Za-z0-9._-]+$"},
        "action": {"type": "string", "minLength": 1}
      }
    },
    "authorityScope": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_slot_ids", "action_bindings"],
      "properties": {
        "authority_source_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "actor_slot_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "action_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/actionBinding"}, "uniqueItems": true},
        "capability_step_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"}
      }
    },
    "capabilityFact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "statement", "statement_sha256", "source_anchor", "root_policy", "producer_semantics", "producer_step_ids", "producer_transition_keys", "consumer_step_ids", "cross_line_dependency", "constraints"],
      "properties": {
        "id": {"type": "string", "pattern": "^CF-[A-Za-z0-9._-]+$"},
        "kind": {"enum": ["upstream_initial", "story_state_anchor", "world_system_output", "authority_token", "resource_state", "environment_state", "capability_output"]},
        "statement": {"type": "string", "minLength": 1},
        "statement_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_anchor": {"$ref": "#/$defs/capabilitySourceAnchor"},
        "root_policy": {"enum": ["root_allowed", "t1_predecessor_required", "producer_required"]},
        "producer_semantics": {"enum": ["none", "any_of", "all_of", "exactly_one"]},
        "producer_step_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "producer_transition_keys": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "consumer_step_ids": {"$ref": "canonical-common.schema.json#/$defs/idSet"},
        "cross_line_dependency": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["source_transition_key", "consumer_transition_key", "precedence_status", "s1_precedence_edge_ids"],
          "properties": {
            "source_transition_key": {"type": "string", "minLength": 1},
            "consumer_transition_key": {"type": "string", "minLength": 1},
            "precedence_status": {"enum": ["structurally_precedes", "incomparable_dependency_candidate"]},
            "s1_precedence_edge_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/strings"},
        "token_kind": {"type": "string", "minLength": 1},
        "issuer_scope": {"$ref": "#/$defs/authorityScope"},
        "consumer_scope": {"$ref": "#/$defs/authorityScope"},
        "consumption_policy": {"enum": ["single_use", "multi_use", "non_consumable"]}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "authority_token"}}, "required": ["kind"]},
          "then": {"required": ["token_kind", "issuer_scope", "consumer_scope", "consumption_policy"]},
          "else": {"not": {"anyOf": [{"required": ["token_kind"]}, {"required": ["issuer_scope"]}, {"required": ["consumer_scope"]}, {"required": ["consumption_policy"]}]}}
        }
      ]
    },
    "capabilitySourceArtifact": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "path", "sha256"],
      "properties": {
        "stage": {"enum": ["S1", "W1", "E1"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "capabilitySourceAnchor": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_kind", "source_artifact", "source_pointer", "value_sha256", "storyline_id", "state_index", "state_sha256"],
          "properties": {
            "source_kind": {"const": "s1_story_state"},
            "source_artifact": {"$ref": "#/$defs/capabilitySourceArtifact"},
            "source_pointer": {"type": "string", "pattern": "^/.+$"},
            "value_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "storyline_id": {"type": "string", "pattern": "^SL-[A-Za-z0-9._-]+$"},
            "state_index": {"type": "integer", "minimum": 0},
            "state_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_kind", "source_artifact", "source_pointer", "value_sha256", "system_or_flow_id", "output_index"],
          "properties": {
            "source_kind": {"const": "w1_system_output"},
            "source_artifact": {"$ref": "#/$defs/capabilitySourceArtifact"},
            "source_pointer": {"type": "string", "pattern": "^/.+$"},
            "value_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            "system_or_flow_id": {"type": "string", "minLength": 1},
            "output_index": {"type": "integer", "minimum": 0}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["source_kind", "source_artifact", "source_pointer", "value_sha256", "environment_id", "subject_kind", "subject_id", "state"],
          "properties": {
            "source_kind": {"const": "e1_initial_state"},
            "source_artifact": {"$ref": "#/$defs/capabilitySourceArtifact"},
            "source_pointer": {"type": "string", "pattern": "^/.+$"},
            "value_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
