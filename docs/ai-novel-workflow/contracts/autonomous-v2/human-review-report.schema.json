{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "human-review-report.schema.json",
  "title": "H1 assembled human review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "h1_session_id",
    "p1_completion",
    "title",
    "review_budget",
    "review_scope_contract",
    "decision_controls",
    "review_path",
    "visual_models",
    "world",
    "storylines",
    "characters",
    "fragments",
    "decision_prompts",
    "source_coverage",
    "reduction_ledger",
    "drilldown_index"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "run_id": {"type": "string", "minLength": 1},
    "h1_session_id": {"type": "string", "minLength": 1},
    "p1_completion": {"$ref": "common-defs.schema.json#/$defs/artifactReference"},
    "title": {"type": "string", "minLength": 1},
    "review_budget": {"$ref": "#/$defs/reviewBudget"},
    "review_scope_contract": {"$ref": "h1-review-plan.schema.json#/$defs/reviewScopeContract"},
    "decision_controls": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "h1-review-plan.schema.json#/$defs/decisionControl"},
      "uniqueItems": true
    },
    "review_path": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"allOf": [{"$ref": "h1-review-plan.schema.json#/$defs/pathStep"}, {"properties": {"kind": {"const": "world"}}}]},
        {"allOf": [{"$ref": "h1-review-plan.schema.json#/$defs/pathStep"}, {"properties": {"kind": {"const": "storylines"}}}]},
        {"allOf": [{"$ref": "h1-review-plan.schema.json#/$defs/pathStep"}, {"properties": {"kind": {"const": "characters"}}}]},
        {"allOf": [{"$ref": "h1-review-plan.schema.json#/$defs/pathStep"}, {"properties": {"kind": {"const": "fragments"}}}]},
        {"allOf": [{"$ref": "h1-review-plan.schema.json#/$defs/pathStep"}, {"properties": {"kind": {"const": "decision"}}}]}
      ],
      "items": false,
      "uniqueItems": true
    },
    "visual_models": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/visualModel"},
      "uniqueItems": true
    },
    "world": {"$ref": "#/$defs/worldSection"},
    "storylines": {"$ref": "#/$defs/storylineSection"},
    "characters": {"$ref": "#/$defs/characterSection"},
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fragment"}
    },
    "decision_prompts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/decisionPrompt"}
    },
    "source_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceCoverage"}
    },
    "reduction_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "h1-review-plan.schema.json#/$defs/reductionEntry"},
      "uniqueItems": true
    },
    "drilldown_index": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "h1-review-plan.schema.json#/$defs/drilldownEntry"},
      "uniqueItems": true
    }
  },
  "$defs": {
    "nullableText": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "reviewBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_minutes", "estimated_minutes", "reading_baseline"],
      "properties": {
        "target_minutes": {"const": 10},
        "estimated_minutes": {"type": "number", "minimum": 0, "maximum": 10},
        "reading_baseline": {"const": "review-reading-baseline-v1"}
      }
    },
    "controlItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "definition",
        "responsibility",
        "must_hold",
        "must_not_imply",
        "source_ids"
      ],
      "properties": {
        "id": {"$ref": "common-defs.schema.json#/$defs/objectId"},
        "title": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "must_hold": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "must_not_imply": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "visualModel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "semantic_role",
        "section_id",
        "visual_kind",
        "title",
        "review_purpose",
        "groups",
        "nodes",
        "edges",
        "text_equivalents",
        "source_ids",
        "text_equivalent_module_id"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^VIS-[A-Za-z0-9._-]+$"},
        "semantic_role": {
          "enum": [
            "control_logic_chain",
            "world_environment_map",
            "storyline_architecture",
            "major_event_timeline",
            "character_relationship_network"
          ]
        },
        "section_id": {"type": "string", "pattern": "^SEC-[A-Za-z0-9._-]+$"},
        "visual_kind": {"enum": ["matrix", "timeline", "network", "flow", "map"]},
        "title": {"type": "string", "minLength": 1},
        "review_purpose": {"type": "string", "minLength": 1},
        "groups": {
          "type": "array",
          "items": {"$ref": "#/$defs/visualGroup"},
          "uniqueItems": true
        },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/visualNode"},
          "uniqueItems": true
        },
        "edges": {
          "type": "array",
          "items": {"$ref": "#/$defs/visualEdge"},
          "uniqueItems": true
        },
        "text_equivalents": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/textEquivalent"},
          "uniqueItems": true
        },
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "text_equivalent_module_id": {"type": "string", "pattern": "^MOD-[A-Za-z0-9._-]+$"}
      }
    },
    "visualGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "label",
        "summary",
        "kind",
        "lane",
        "tier",
        "temporal_label",
        "source_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^GRP-[A-Za-z0-9._-]+$"},
        "order": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "lane": {"$ref": "#/$defs/nullableText"},
        "tier": {"$ref": "#/$defs/nullableText"},
        "temporal_label": {"$ref": "#/$defs/nullableText"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "visualNode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "group_id",
        "label",
        "summary",
        "kind",
        "lane",
        "tier",
        "temporal_label",
        "source_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^NODE-[A-Za-z0-9._-]+$"},
        "order": {"type": "integer", "minimum": 1},
        "group_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^GRP-[A-Za-z0-9._-]+$"}
          ]
        },
        "label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "lane": {"$ref": "#/$defs/nullableText"},
        "tier": {"$ref": "#/$defs/nullableText"},
        "temporal_label": {"$ref": "#/$defs/nullableText"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "visualEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "group_id",
        "from_node_id",
        "to_node_id",
        "direction",
        "relation_label",
        "summary",
        "kind",
        "lane",
        "tier",
        "temporal_label",
        "source_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^EDGE-[A-Za-z0-9._-]+$"},
        "order": {"type": "integer", "minimum": 1},
        "group_id": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^GRP-[A-Za-z0-9._-]+$"}
          ]
        },
        "from_node_id": {"type": "string", "pattern": "^NODE-[A-Za-z0-9._-]+$"},
        "to_node_id": {"type": "string", "pattern": "^NODE-[A-Za-z0-9._-]+$"},
        "direction": {"enum": ["directed", "bidirectional", "undirected"]},
        "relation_label": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "lane": {"$ref": "#/$defs/nullableText"},
        "tier": {"$ref": "#/$defs/nullableText"},
        "temporal_label": {"$ref": "#/$defs/nullableText"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "textEquivalent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "element_ids",
        "text",
        "source_ids"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^TXT-[A-Za-z0-9._-]+$"},
        "order": {"type": "integer", "minimum": 1},
        "element_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(GRP|NODE|EDGE)-[A-Za-z0-9._-]+$"
          },
          "uniqueItems": true
        },
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "worldSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "operating_logic",
        "systems",
        "environments",
        "event_conditions",
        "constraints",
        "boundaries",
        "source_ids"
      ],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "operating_logic": {"type": "string", "minLength": 1},
        "systems": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "environments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "event_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "boundaries": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "storylineSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "story_subject",
        "lines",
        "connections",
        "major_events",
        "suspense_conflict_rhythm",
        "constraints",
        "source_ids"
      ],
      "properties": {
        "story_subject": {"type": "string", "minLength": 1},
        "lines": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "connections": {"type": "array", "items": {"$ref": "#/$defs/controlItem"}},
        "major_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "suspense_conflict_rhythm": {"type": "string", "minLength": 1},
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "characterSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_characters",
        "supporting_characters",
        "relationship_networks",
        "role_coverage",
        "constraints",
        "source_ids"
      ],
      "properties": {
        "core_characters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "supporting_characters": {"type": "array", "items": {"$ref": "#/$defs/controlItem"}},
        "relationship_networks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "role_coverage": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/controlItem"}},
        "constraints": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyStrings"},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    },
    "fragment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "review_purpose", "text", "source_ids", "decision_control_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^FRAG-[A-Za-z0-9._-]+$"},
        "title": {"type": "string", "minLength": 1},
        "review_purpose": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "decision_control_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^DCTRL-[A-Za-z0-9._-]+$"},
          "uniqueItems": true
        }
      }
    },
    "decisionPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "affected_source_ids", "allowed_decisions"],
      "properties": {
        "id": {"type": "string", "pattern": "^PROMPT-[A-Za-z0-9._-]+$"},
        "question": {"type": "string", "minLength": 1},
        "affected_source_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"},
        "allowed_decisions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"const": "approved"},
            {"const": "revise"},
            {"const": "rejected"}
          ]
        }
      }
    },
    "sourceCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "visible_element_ids"],
      "properties": {
        "source_id": {"$ref": "common-defs.schema.json#/$defs/objectId"},
        "visible_element_ids": {"$ref": "canonical-common.schema.json#/$defs/nonEmptyIdSet"}
      }
    }
  }
}
