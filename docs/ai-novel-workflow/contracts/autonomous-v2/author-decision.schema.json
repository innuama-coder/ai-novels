{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-decision.schema.json",
  "title": "Autonomous conception V2 author decision",
  "oneOf": [
    {"$ref": "#/$defs/approved"},
    {"$ref": "#/$defs/revise"},
    {"$ref": "#/$defs/rejected"}
  ],
  "$defs": {
    "machinePackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_path",
        "completion_sha256",
        "manifest_path",
        "manifest_sha256"
      ],
      "properties": {
        "completion_path": {"$ref": "common-defs.schema.json#/$defs/relativePath"},
        "completion_sha256": {"$ref": "common-defs.schema.json#/$defs/sha256"},
        "manifest_path": {"$ref": "common-defs.schema.json#/$defs/relativePath"},
        "manifest_sha256": {"$ref": "common-defs.schema.json#/$defs/sha256"}
      }
    },
    "humanReviewPackage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completion_path",
        "completion_sha256",
        "manifest_path",
        "manifest_sha256",
        "html_path",
        "html_sha256"
      ],
      "properties": {
        "completion_path": {"$ref": "common-defs.schema.json#/$defs/relativePath"},
        "completion_sha256": {"$ref": "common-defs.schema.json#/$defs/sha256"},
        "manifest_path": {"$ref": "common-defs.schema.json#/$defs/relativePath"},
        "manifest_sha256": {"$ref": "common-defs.schema.json#/$defs/sha256"},
        "html_path": {"$ref": "common-defs.schema.json#/$defs/relativePath"},
        "html_sha256": {"$ref": "common-defs.schema.json#/$defs/sha256"}
      }
    },
    "approved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "approval_scope",
        "decision",
        "machine_package",
        "human_review_package",
        "approval_record",
        "unresolved_items"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "run_id": {"type": "string", "minLength": 1},
        "approval_scope": {"const": "conception"},
        "decision": {"const": "approved"},
        "machine_package": {"$ref": "#/$defs/machinePackage"},
        "human_review_package": {"$ref": "#/$defs/humanReviewPackage"},
        "approval_record": {"$ref": "common-defs.schema.json#/$defs/approvalRecord"},
        "unresolved_items": {
          "type": "array",
          "items": {"$ref": "common-defs.schema.json#/$defs/sourceId"},
          "uniqueItems": true
        }
      }
    },
    "revise": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "approval_scope",
        "decision",
        "machine_package",
        "human_review_package",
        "revision_record",
        "revision_targets"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "run_id": {"type": "string", "minLength": 1},
        "approval_scope": {"const": "conception"},
        "decision": {"const": "revise"},
        "machine_package": {"$ref": "#/$defs/machinePackage"},
        "human_review_package": {"$ref": "#/$defs/humanReviewPackage"},
        "revision_record": {"$ref": "common-defs.schema.json#/$defs/approvalRecord"},
        "revision_targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/revisionTarget"}
        }
      }
    },
    "revisionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_scope",
        "visible_element_ids",
        "source_ids",
        "requested_change"
      ],
      "properties": {
        "target_scope": {"enum": ["conception", "report", "fragment", "html"]},
        "visible_element_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {"$ref": "common-defs.schema.json#/$defs/sourceId"},
          "uniqueItems": true
        },
        "requested_change": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"target_scope": {"const": "conception"}}},
          "then": {
            "properties": {
              "source_ids": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_scope": {"enum": ["report", "fragment", "html"]}
            }
          },
          "then": {
            "properties": {
              "visible_element_ids": {"minItems": 1}
            }
          }
        }
      ]
    },
    "rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "run_id",
        "approval_scope",
        "decision",
        "machine_package",
        "human_review_package",
        "rejection_record"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "run_id": {"type": "string", "minLength": 1},
        "approval_scope": {"const": "conception"},
        "decision": {"const": "rejected"},
        "machine_package": {"$ref": "#/$defs/machinePackage"},
        "human_review_package": {"$ref": "#/$defs/humanReviewPackage"},
        "rejection_record": {"$ref": "common-defs.schema.json#/$defs/approvalRecord"}
      }
    }
  }
}
