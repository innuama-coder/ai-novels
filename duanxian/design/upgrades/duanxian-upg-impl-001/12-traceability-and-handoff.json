 "consumption_order": [
  "README.md",
  "00-baseline-and-authority.json",
  "01-control-register.json",
  "02-legacy-disposition.md + 03-source-migration.csv",
  "11-owner-decisions.md",
  "04-character-responsibility.md + 05-capability-and-evidence.md",
  "06-causal-and-event-map.json + 07-information-ledger.csv",
  "08-ending-and-pov.md",
  "09-scene-specs.md + 10-text-adaptation-map.csv",
  "12-traceability-and-handoff.json",
  "13-regression-results.md + manifest.json"
 ],
 "allowed_freedoms": [
  "局部措辞与场景进入方式（不改变事实的表达）",
  "在 09 规格边界内细化动作/对白条件/感官材料",
  "在不违反 05/07 的前提下安排合法文字通道内的具体交流内容"
 ],
 "must_not_invent": [
  "新核心事实（袭击机制/责任人/新增配角/终局机制）——一律回 11 决策点",
  "R-07 的新能力或新输入通道（05§E1 白名单外）",
  "旧链内容的直接复用（必经 02 处置表）",
  "未批分支的确定化（conditional_on_* 块）"
 ],
